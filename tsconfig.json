{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "netlify/**/*", "functions/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}

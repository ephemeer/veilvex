---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getContent, DEFAULT_LANG } from '../i18n';
const t = await getContent(DEFAULT_LANG);
---
<Base lang={DEFAULT_LANG} t={t} path="/" title={`404 — ${t.brand}`} noindex>
  <section class="nf">
    <div class="bg-glow" aria-hidden="true"></div>
    <div class="container nf__inner">
      <span class="mono nf__code">404</span>
      <h1 class="h2">{t.notFound.title}</h1>
      <p class="lead">{t.notFound.text}</p>
      <a href="/" class="btn btn--primary btn--lg btn--swap"><span class="btn__label" data-text={t.notFound.back}><span>{t.notFound.back}</span></span><Icon name="arrow-turn" /></a>
    </div>
  </section>
</Base>
<style>
  .nf {
    position: relative;
    /* own stacking context, like .hero: the z-index:-1 .bg-glow must paint above the body background */
    isolation: isolate;
    overflow: clip;
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: calc(var(--nav-h) + 48px) 0 64px;
  }
  .nf__inner {
    display: grid;
    gap: 18px;
    justify-items: start;
    max-width: 640px;
  }
  .nf__code {
    font-size: 14px;
    color: var(--lime);
  }
</style>

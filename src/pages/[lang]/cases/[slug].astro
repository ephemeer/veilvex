---
import Base from '../../../layouts/Base.astro';
import CasePage from '../../../components/CasePage.astro';
import { getContent, LANGS, DEFAULT_LANG } from '../../../i18n';
import type { Lang } from '../../../i18n/types';
import { CASE_SLUGS, type CaseSlug } from '../../../i18n/cases';
import { caseSeo } from '../../../lib/case-seo';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).flatMap((lang) => CASE_SLUGS.map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as CaseSlug;
const t = await getContent(lang);
const seo = caseSeo(lang, t, slug);
---
<Base lang={lang} t={t} path={seo.path} title={seo.title} description={seo.description} ogType="article" caseStudy={seo.caseStudy}>
  <CasePage lang={lang} t={t} slug={slug} />
</Base>

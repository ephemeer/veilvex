---
import Base from '../../layouts/Base.astro';
import PrivacyPage from '../../components/PrivacyPage.astro';
import { getContent, LANGS, DEFAULT_LANG } from '../../i18n';
import type { Lang } from '../../i18n/types';

export function getStaticPaths() {
  return LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = await getContent(lang);
---
<Base lang={lang} t={t} path="/privacy" title={`${t.privacy.title} — ${t.brand}`} description={t.privacy.intro}>
  <PrivacyPage lang={lang} t={t} />
</Base>

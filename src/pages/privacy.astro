---
import Base from '../layouts/Base.astro';
import PrivacyPage from '../components/PrivacyPage.astro';
import { getContent, DEFAULT_LANG } from '../i18n';
const t = await getContent(DEFAULT_LANG);
---
<Base lang={DEFAULT_LANG} t={t} path="/privacy" title={`${t.privacy.title} — ${t.brand}`} description={t.privacy.intro}>
  <PrivacyPage lang={DEFAULT_LANG} t={t} />
</Base>

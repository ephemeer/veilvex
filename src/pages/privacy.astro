---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';
import { getContent, DEFAULT_LANG } from '../i18n';
const lang = DEFAULT_LANG;
const t = await getContent(lang);
---
<Base lang={lang} t={t} path="/privacy" title={`${t.privacy.title} — ${t.brand}`} description={t.privacy.description}>
  <LegalPage lang={lang} t={t} doc="privacy" />
</Base>

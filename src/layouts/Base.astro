---
import '@fontsource-variable/inter';
// Preloaded subsets: the woff2 files the first paint needs, by language (hashed URLs via Vite `?url`,
// the same assets the @fontsource CSS references). Everything else loads on demand (font-display: swap).
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import type { Content, Lang } from '../i18n/types';
import { LANGS, localePath, plain } from '../i18n';
import { buildJsonLd, ogImageAlt, serializeJsonLd } from '../lib/jsonld';
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandBar from '../components/CommandBar.astro';

interface Props {
  lang: Lang;
  t: Content;
  /** Page path without the language prefix, e.g. '/' or '/privacy' */
  path?: string;
  title?: string;
  description?: string;
  /** Hide the main nav/footer (404 page) */
  bare?: boolean;
  noindex?: boolean;
}

const { lang, t, path = '/', title, description, bare = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://veilvex.netlify.app');
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonical = new URL(localePath(lang, path), site).href;
const ogImage = new URL('/og.png', site).href;
const ogAlt = ogImageAlt(t);
// JSON-LD: full graph (Organization, WebSite, WebPage, 9 × Service, the cases as an ItemList of CreativeWork, FAQPage) on the home pages,
// Organization + WebSite + WebPage + breadcrumbs on other indexable pages, nothing on noindex pages.
const schema = buildJsonLd({ lang, t, site, path, title: pageTitle, description: plain(pageDesc), scope: noindex ? 'none' : path === '/' ? 'home' : 'page' });
const jsonLd = schema ? serializeJsonLd(schema) : '';
// ru: Cyrillic + Latin (brand, numbers); az: Latin + Latin Extended (ə, ş, ğ); en/de: Latin only.
const fontPreloads = [interLatin, ...(lang === 'ru' ? [interCyrillic] : []), ...(lang === 'az' ? [interLatinExt] : [])];
---

<!doctype html>
<html lang={t.locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    {/* `js` gates the entrance animations; `mac`/`pc` picks the ⌘K / Ctrl K label before the first paint (Nav.astro).
        The only inline script: its sha256 is in the CSP (netlify.toml) — change it and recompute the hash. */}
    <script is:inline>document.documentElement.classList.add("js",/mac|iph|ipad|ipod/i.test(navigator.platform)?"mac":"pc")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {fontPreloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {/* module scripts are deferred anyway; from <head> the preload scanner fetches the bundle alongside the CSS
        instead of after the whole document has arrived (on Slow 4G that is ~1 s earlier) */}
    <script src="../scripts/main.ts"></script>
    <meta name="description" content={plain(pageDesc)} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ru', path), site).href} />
    <meta name="theme-color" content="#08090a" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={noindex ? 'noindex' : 'index,follow,max-image-preview:large'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:locale" content={t.locale.replace('-', '_')} />
    <meta property="og:title" content={title ?? t.meta.ogTitle} />
    <meta property="og:description" content={plain(description ?? t.meta.ogDescription)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? t.meta.ogTitle} />
    <meta name="twitter:description" content={plain(description ?? t.meta.ogDescription)} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <Icons />
    {!bare && <Nav lang={lang} t={t} path={path} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} t={t} />}
    {!bare && <CommandBar lang={lang} t={t} path={path} />}
  </body>
</html>

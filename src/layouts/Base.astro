---
import '@fontsource-variable/inter';
import '../styles/global.css';
import type { Content, Lang } from '../i18n/types';
import { LANGS, localePath, plain } from '../i18n';
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandBar from '../components/CommandBar.astro';

interface Props {
  lang: Lang;
  t: Content;
  /** Page path without the language prefix, e.g. '/' or '/privacy' */
  path?: string;
  title?: string;
  description?: string;
  /** Hide the main nav/footer (404 page) */
  bare?: boolean;
  noindex?: boolean;
}

const { lang, t, path = '/', title, description, bare = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://veilvex.netlify.app');
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonical = new URL(localePath(lang, path), site).href;
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={t.locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={plain(pageDesc)} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ru', path), site).href} />
    <meta name="theme-color" content="#08090a" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:locale" content={t.locale.replace('-', '_')} />
    <meta property="og:title" content={title ?? t.meta.ogTitle} />
    <meta property="og:description" content={plain(description ?? t.meta.ogDescription)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? t.meta.ogTitle} />
    <meta name="twitter:description" content={plain(description ?? t.meta.ogDescription)} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <Icons />
    {!bare && <Nav lang={lang} t={t} path={path} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} t={t} />}
    {!bare && <CommandBar lang={lang} t={t} path={path} />}
    <script src="../scripts/main.ts"></script>
  </body>
</html>

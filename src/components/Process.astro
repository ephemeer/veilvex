---
import type { Content } from '../i18n/types';
import SectionHead from './SectionHead.astro';
interface Props {
  t: Content;
}
const { t } = Astro.props;
---
<section class="section process" id="process">
  <div class="container">
    <SectionHead index="03" tag={t.process.tag} title={t.process.title} lead={t.process.lead} />
    <ol class="process__steps" data-process>
      <div class="process__rail" aria-hidden="true"><i class="process__beam" data-beam></i></div>
      {t.process.steps.map((s, i) => (
        <li class="process__step reveal" data-i={i} data-step>
          <span class="process__pin" aria-hidden="true"></span>
          <div class="process__meta">
            <span class="process__n mono">0{i + 1}</span>
            <span class="chip">{s.badge}</span>
          </div>
          <h3 class="h3 process__title">{s.title}</h3>
          <p class="process__desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .process__steps {
    position: relative;
    display: grid;
    gap: 36px;
    padding-left: 28px;
  }
  .process__rail {
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line-2);
  }
  .process__beam {
    position: absolute;
    inset: 0;
    background: var(--lime);
    box-shadow: 0 0 12px var(--lime-glow);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }
  .process__step {
    position: relative;
    display: grid;
    gap: 10px;
  }
  .process__pin {
    position: absolute;
    left: -28px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--bg);
    transition: border-color 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }
  .process__step.is-lit .process__pin {
    border-color: var(--lime);
    background: var(--lime);
    box-shadow: 0 0 12px var(--lime-glow);
  }
  .process__meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .process__n {
    color: var(--fg-3);
    transition: color 200ms ease;
  }
  .process__step.is-lit .process__n {
    color: var(--lime);
  }
  .process__desc {
    font-size: 14.5px;
    color: var(--fg-2);
    line-height: 1.55;
    max-width: 420px;
  }
  @media (min-width: 900px) {
    .process__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
      padding-left: 0;
      padding-top: 36px;
    }
    .process__rail {
      left: 0;
      right: 0;
      top: 5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .process__beam {
      transform-origin: left;
      transform: scaleX(var(--p, 0));
    }
    .process__pin {
      left: 0;
      top: -36px;
    }
    .process__step {
      padding-right: 16px;
    }
  }
</style>

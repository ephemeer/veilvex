---
/**
 * A case-study page (/cases/<slug>/, every language): the full story behind a card on the home page.
 * Content: src/i18n/cases/<lang>.ts (typed by CaseDetail) + the card's title / kind / type from
 * `cases.items`; language-independent facts (live site, screenshots) from src/i18n/cases/meta.ts.
 *
 * Layout: breadcrumb → kicker, H1, lead, facts, tech chips, CTA + live site → screenshot (or the card's
 * line art) → table of contents (sticky aside on desktop, a <details> toggle on phones) beside the
 * numbered sections → CTA card → previous / next case. The CTA lands on the home request form with the
 * case's service preselected (`?service=` + #contact, read by contact.ts).
 *
 * Motion: the hero is simply there (it is the page); sections and the CTA use the shared first-view
 * reveal (.reveal, reveal.ts); the TOC marks the section being read (case-page.ts, colour only).
 */
import type { Content, Lang } from '../i18n/types';
import { localePath, pad2 } from '../i18n';
import { CASE_META, CASE_SERVICE, CASE_SLUGS, casePath, getCaseDetails, type CaseSlug } from '../i18n/cases';
import CaseArt from './CaseArt.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  t: Content;
  slug: CaseSlug;
}
const { lang, t, slug } = Astro.props;
const { labels: L, items } = getCaseDetails(lang);
const i = CASE_SLUGS.indexOf(slug);
const total = CASE_SLUGS.length;
const card = t.cases.items[i]!;
const d = items[slug];
const meta = CASE_META[slug];
const home = localePath(lang, '/');
const live = meta.live?.[lang];
const cta = `${home}?service=${CASE_SERVICE[card.type]}#contact`;
const sib = (k: number) => {
  const j = (i + k + total) % total;
  const s = CASE_SLUGS[j]!;
  return { href: localePath(lang, casePath(s)), title: t.cases.items[j]!.title, kind: t.cases.items[j]!.kind, n: pad2(j + 1) };
};
const prev = sib(-1);
const next = sib(1);
const shot = (k: number) => {
  const s = meta.shots[k];
  if (!s) return null;
  const base = `/cases/${slug}/${s.n}`;
  return { src: `${base}.webp`, srcset: `${base}-640.webp 640w, ${base}.webp 1280w`, width: s.width, height: s.height, alt: d.shots[k] ?? card.title };
};
const hero = shot(0);
const inline = shot(1);
// the second screenshot sits after the design section (every case with two screenshots has one)
const inlineAfter = d.sections.some((s) => s.id === 'design') ? 'design' : d.sections[1]?.id;
const toc = d.sections.map((s, k) => ({ id: s.id, title: s.title, n: pad2(k + 1) }));
---
<article class="cs" data-case-page={slug}>
  <header class="cs-hero">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="container cs-hero__inner">
      <nav class="cs-crumbs" aria-label={L.crumbs}>
        <ol>
          <li><a href={home}>{L.home}</a></li>
          <li><a href={`${home}#cases`}>{L.breadcrumb}</a></li>
          <li aria-current="page">{card.title}</li>
        </ol>
      </nav>
      <p class="eyebrow cs-kicker">{t.cases.sheet.kicker} {pad2(i + 1)} {L.of} {pad2(total)} · {card.kind}</p>
      <h1 class="cs-title">{card.title}</h1>
      <p class="lead cs-lead">{d.lead}</p>
      <dl class="cs-facts">
        <div class="cs-fact cs-fact--result">
          <dt>{t.cases.sheet.result}</dt>
          <dd>{d.result}</dd>
        </div>
        {d.facts.map((f) => (
          <div class="cs-fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="cs-tech">
        <span class="mono cs-tech__label" id="cs-tech-label">{t.cases.sheet.tech}</span>
        <ul class="cs-tags" aria-labelledby="cs-tech-label">
          {d.tags.map((tag) => <li class="chip">{tag}</li>)}
        </ul>
      </div>
      <div class="cs-actions">
        <a href={cta} class="btn btn--primary btn--lg btn--swap" data-case-cta><span class="btn__label" data-text={L.cta}><span>{L.cta}</span></span><Icon name="arrow-turn" /></a>
        {live && (
          <a href={live} class="btn btn--secondary btn--lg" target="_blank" rel="noopener noreferrer" data-case-live>
            {L.live}<Icon name="arrow-up-right" size={14} /><span class="sr-only"> ({L.newTab})</span>
          </a>
        )}
      </div>
    </div>
  </header>

  <div class="container">
    <figure class="cs-media">
      {hero ? (
        <img src={hero.src} srcset={hero.srcset} sizes="(min-width: 1200px) 1120px, 100vw" width={hero.width} height={hero.height} alt={hero.alt} decoding="async" fetchpriority="high" data-fade />
      ) : (
        <div class="cs-art"><CaseArt type={card.type} idx={i} idPrefix="p" /></div>
      )}
    </figure>
  </div>

  <div class="container cs-body">
    <aside class="cs-aside">
      <nav class="cs-toc" aria-label={L.toc}>
        <p class="mono cs-toc__title">{L.toc}</p>
        <ol>
          {toc.map((s) => (
            <li><a href={`#${s.id}`} data-toc-link={s.id}><span class="cs-toc__n">{s.n}</span><span>{s.title}</span></a></li>
          ))}
        </ol>
      </nav>
    </aside>

    <div class="cs-content">
      <details class="cs-toc-m">
        <summary><span>{L.toc}</span><span class="mono cs-toc-m__count">{pad2(toc.length)}</span><Icon name="chevron" size={14} class="cs-toc-m__chev" /></summary>
        <nav class="cs-toc cs-toc--m" aria-label={L.toc}>
          <ol>
            {toc.map((s) => (
              <li><a href={`#${s.id}`} data-toc-link={s.id}><span class="cs-toc__n">{s.n}</span><span>{s.title}</span></a></li>
            ))}
          </ol>
        </nav>
      </details>

      {d.sections.map((s, k) => (
        <Fragment>
          <section class="cs-sec reveal" id={s.id} aria-labelledby={`${s.id}-title`} data-case-section>
            <h2 class="cs-sec__title" id={`${s.id}-title`}><span class="cs-sec__n mono">{pad2(k + 1)}</span>{s.title}</h2>
            {s.blocks.map((b) =>
              'p' in b ? (
                <p class="cs-p">{b.p}</p>
              ) : 'ul' in b ? (
                <ul class="cs-list">
                  {b.ul.map((it) => (
                    <li><Icon name="check" size={12} />{it}</li>
                  ))}
                </ul>
              ) : 'ol' in b ? (
                <ol class="cs-steps">
                  {b.ol.map((it, n) => (
                    <li><span class="cs-steps__n mono" aria-hidden="true">{pad2(n + 1)}</span><span>{it}</span></li>
                  ))}
                </ol>
              ) : (
                <dl class="cs-stats">
                  {b.stats.map((st) => (
                    <div class="cs-stat">
                      <dt>{st.label}</dt>
                      <dd>{st.value}</dd>
                    </div>
                  ))}
                </dl>
              ),
            )}
          </section>
          {inline && s.id === inlineAfter && (
            <figure class="cs-media cs-media--inline reveal">
              <img src={inline.src} srcset={inline.srcset} sizes="(min-width: 1024px) 760px, 100vw" width={inline.width} height={inline.height} alt={inline.alt} loading="lazy" decoding="async" data-fade />
            </figure>
          )}
        </Fragment>
      ))}
    </div>
  </div>

  <section class="container cs-cta reveal" aria-labelledby="cs-cta-title">
    <div class="cs-cta__card">
      <div class="cs-cta__text">
        <h2 class="h2" id="cs-cta-title">{L.ctaTitle}</h2>
        <p class="lead">{L.ctaText}</p>
      </div>
      <a href={cta} class="btn btn--primary btn--lg btn--swap cs-cta__btn" data-case-cta><span class="btn__label" data-text={L.cta}><span>{L.cta}</span></span><Icon name="arrow-turn" /></a>
    </div>
  </section>

  <nav class="container cs-pager" aria-label={L.all}>
    <a href={prev.href} class="cs-pager__link cs-pager__link--prev" rel="prev" data-case-prev>
      <span class="mono cs-pager__dir"><Icon name="arrow" size={12} class="cs-pager__back" />{L.prev}</span>
      <span class="cs-pager__title">{prev.title}</span>
      <span class="mono cs-pager__kind">{prev.n} · {prev.kind}</span>
    </a>
    <a href={`${home}#cases`} class="link-arrow cs-pager__all">{L.all}</a>
    <a href={next.href} class="cs-pager__link cs-pager__link--next" rel="next" data-case-next>
      <span class="mono cs-pager__dir">{L.next}<Icon name="arrow" size={12} /></span>
      <span class="cs-pager__title">{next.title}</span>
      <span class="mono cs-pager__kind">{next.n} · {next.kind}</span>
    </a>
  </nav>
</article>

<style>
  .cs-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: calc(var(--nav-h) + clamp(32px, 6vw, 72px)) 0 clamp(32px, 5vw, 56px);
  }
  .cs-hero__inner {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  /* breadcrumb */
  .cs-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 0;
    font-size: 13px;
    color: var(--fg-3);
  }
  .cs-crumbs li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }
  .cs-crumbs li + li::before {
    content: '/';
    padding-inline: 8px;
    color: var(--line-2);
  }
  .cs-crumbs a {
    color: var(--fg-2);
    transition: color 160ms ease;
  }
  .cs-crumbs [aria-current] {
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .cs-kicker {
    margin-top: 12px;
  }
  .cs-title {
    max-width: 16em;
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 540;
    letter-spacing: -0.035em;
    line-height: 1.03;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .cs-lead {
    max-width: 680px;
  }
  /* facts: result first, then timeline / delivered / cost — a quiet data row */
  .cs-facts {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .cs-fact {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .cs-fact dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .cs-fact dd {
    font-size: 15px;
    line-height: 1.45;
    color: var(--fg);
  }
  .cs-fact--result dd {
    color: var(--lime);
  }
  .cs-tech {
    display: grid;
    gap: 10px;
  }
  .cs-tech__label {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .cs-actions :global(.btn--secondary .icon) {
    color: var(--fg-2);
  }

  /* screenshot / line art */
  .cs-media {
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.8);
  }
  .cs-media img {
    width: 100%;
    height: auto;
  }
  /* A light client screenshot popping into the dark page reads as a flash on a slow connection: with JS
     it waits transparent on the frame's dark surface and fades in once loaded (case-page.ts), opacity only,
     the long marketing ease; an image that is already there when the script runs is simply shown. */
  :global(html.js) .cs-media img[data-fade] {
    transition: opacity 600ms var(--ease-out-long);
  }
  :global(html.js) .cs-media img[data-fade]:not(.is-loaded) {
    opacity: 0;
  }
  /* no screenshot: the card's line art, centred in a wide band; the band repeats the art's own 20px grid
     so the letterboxed edges read as one surface */
  .cs-art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background-color: var(--surface);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: center;
  }
  .cs-art :global(svg) {
    width: auto;
    height: 100%;
    max-width: 100%;
  }
  .cs-media--inline {
    margin: 8px 0 0;
  }

  /* body: TOC + sections */
  .cs-body {
    display: grid;
    gap: 32px;
    padding-top: clamp(40px, 6vw, 72px);
  }
  .cs-aside {
    display: none;
  }
  .cs-content {
    display: grid;
    gap: clamp(40px, 5vw, 56px);
    min-width: 0;
    max-width: 760px;
  }
  .cs-toc ol {
    display: grid;
    gap: 2px;
  }
  .cs-toc a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 7px 10px;
    border-radius: var(--r-sm);
    font-size: 14px;
    line-height: 1.35;
    color: var(--fg-2);
    transition: color 150ms ease, background-color 150ms ease;
  }
  .cs-toc__n {
    flex: none;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    transition: color 150ms ease;
  }
  .cs-toc a[aria-current='location'] {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.04);
  }
  .cs-toc a[aria-current='location'] .cs-toc__n {
    color: var(--lime);
  }
  .cs-toc__title {
    margin: 0 0 10px 10px;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  /* phones: a collapsed toggle above the first section */
  .cs-toc-m {
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.015);
  }
  .cs-toc-m summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 16px;
    font-size: 15px;
    font-weight: 520;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-lg);
    transition: transform 140ms var(--ease-out);
  }
  .cs-toc-m summary::-webkit-details-marker {
    display: none;
  }
  .cs-toc-m summary:active {
    transform: scale(0.98);
  }
  .cs-toc-m__count {
    margin-left: auto;
  }
  .cs-toc-m :global(.cs-toc-m__chev) {
    color: var(--fg-2);
    transition: transform 200ms var(--ease-out);
  }
  .cs-toc-m[open] :global(.cs-toc-m__chev) {
    transform: rotate(180deg);
  }
  .cs-toc--m {
    padding: 0 6px 10px;
  }
  .cs-toc--m a {
    min-height: 44px;
    align-items: center;
  }

  /* sections */
  .cs-sec {
    display: grid;
    gap: 16px;
  }
  .cs-sec__title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .cs-sec__n {
    flex: none;
    color: var(--lime);
  }
  .cs-p {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--fg-2);
    text-wrap: pretty;
  }
  .cs-list {
    display: grid;
    gap: 12px;
  }
  .cs-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg-2);
  }
  .cs-list :global(.icon) {
    flex: none;
    margin-top: 7px;
    color: var(--lime);
  }
  .cs-steps {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .cs-steps li {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--fg-2);
  }
  .cs-steps__n {
    flex: none;
    padding-top: 3px;
    color: var(--lime);
  }
  .cs-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--line);
  }
  .cs-stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 18px 16px;
    background: var(--bg);
  }
  .cs-stat dd {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .cs-stat dt {
    font-size: 13px;
    line-height: 1.45;
    color: var(--fg-2);
  }

  /* CTA card */
  .cs-cta {
    padding-top: clamp(64px, 9vw, 112px);
  }
  .cs-cta__card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 24px;
    justify-items: start;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid rgba(198, 255, 74, 0.22);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(198, 255, 74, 0.09), transparent 55%),
      rgba(255, 255, 255, 0.015);
  }
  .cs-cta__text {
    display: grid;
    gap: 12px;
    max-width: 640px;
  }

  /* previous / next */
  .cs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-block: clamp(32px, 5vw, 56px) clamp(64px, 8vw, 96px);
  }
  .cs-pager__link {
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.015);
    transition: transform 140ms var(--ease-out), border-color 200ms ease, background-color 200ms ease;
  }
  .cs-pager__link:active {
    transform: scale(0.98);
  }
  .cs-pager__link--next {
    text-align: right;
    justify-items: end;
  }
  .cs-pager__dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    font-size: 11px;
  }
  .cs-pager__dir :global(.cs-pager__back) {
    transform: scaleX(-1);
  }
  .cs-pager__title {
    font-size: 17px;
    font-weight: 520;
    letter-spacing: -0.015em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .cs-pager__kind {
    font-size: 11px;
  }
  .cs-pager__all {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    padding: 10px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-crumbs a:hover {
      color: var(--fg);
    }
    .cs-toc a:hover {
      color: var(--fg);
    }
    .cs-pager__link:hover {
      border-color: rgba(198, 255, 74, 0.28);
      background: rgba(255, 255, 255, 0.025);
    }
  }

  @media (min-width: 640px) {
    .cs-facts {
      grid-template-columns: 2fr repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }
  @media (min-width: 768px) {
    .cs-art {
      aspect-ratio: 21 / 8;
    }
    .cs-pager {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
    .cs-pager__all {
      grid-column: 2;
      grid-row: 1;
    }
    .cs-cta__card {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  /* desktop: the table of contents becomes a sticky column beside the text */
  @media (min-width: 1024px) {
    .cs-body {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 64px;
    }
    .cs-aside {
      display: block;
    }
    .cs-toc:not(.cs-toc--m) {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
    .cs-toc-m {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .cs-media img[data-fade] {
      transition-duration: 200ms;
    }
    .cs-pager__link:active,
    .cs-toc-m summary:active {
      transform: none;
    }
    .cs-toc-m :global(.cs-toc-m__chev) {
      transition: none;
    }
  }
</style>

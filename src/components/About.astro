---
import type { Content } from '../i18n/types';
import { hl } from '../i18n';
interface Props {
  t: Content;
}
const { t } = Astro.props;

/**
 * Sparkline per stat (120×32): a rising 12-point line whose wobble is a deterministic function of the
 * stat value (a tiny LCG seeded from it), so every build and every language draws the same shape.
 * Drawn on reveal by draw.ts (stroke dash); the mint end dot fades in when the line arrives.
 */
const sparkline = (value: number, i: number) => {
  let s = Math.round(value * 100) + i * 7919 + 17;
  const rnd = () => (s = (s * 9301 + 49297) % 233280) / 233280;
  const n = 12;
  const pts = Array.from({ length: n }, (_, k) => {
    const t = k / (n - 1);
    const trend = 27 - 22 * Math.pow(t, 1.35);
    const noise = (rnd() - 0.5) * 9 * (1 - t * 0.6);
    return [2 + t * 114, Math.min(29, Math.max(3, trend + noise))] as const;
  });
  const [ex, ey] = pts[n - 1] ?? [116, 5];
  return { d: pts.map(([x, y], k) => `${k ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' '), ex, ey };
};
---
<section class="section about" id="about">
  <div class="container">
    <span class="eyebrow reveal">{t.about.tag}</span>
    <p class="about__text reveal" set:html={hl(t.about.text)} />
    <ul class="about__stats">
      {t.about.stats.map((s, i) => {
        const sp = sparkline(s.value, i);
        return (
          <li class="about__stat reveal" data-i={i}>
            <span class="about__value">
              {s.prefix && <span class="about__affix">{s.prefix}</span>}
              <span class="about__num" data-count={s.value} data-decimals={s.decimals}>{s.value.toLocaleString(t.locale, { minimumFractionDigits: s.decimals, maximumFractionDigits: s.decimals })}</span>
              {s.suffix && <span class="about__affix">{s.suffix}</span>}
            </span>
            <svg class="spark" viewBox="0 0 120 32" aria-hidden="true" focusable="false" data-spark>
              <path class="spark__line" d={sp.d} pathLength="100" data-draw data-draw-duration="900" data-draw-delay="120" />
              <circle class="spark__end" cx={sp.ex} cy={sp.ey} r="2.5" data-draw-end />
            </svg>
            <span class="about__label">{s.label}</span>
            <span class="about__sub">{s.sub}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .about__text {
    margin-top: 22px;
    max-width: 1000px;
    font-size: clamp(26px, 3.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: var(--fg-2);
    text-wrap: balance;
  }
  .about__text :global(.hl) {
    color: var(--fg);
    position: relative;
  }
  .about__stats {
    display: grid;
    gap: 0;
    margin-top: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
    grid-template-columns: 1fr;
  }
  .about__stat {
    display: grid;
    gap: 6px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .about__value {
    display: inline-flex;
    align-items: baseline;
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 540;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .about__affix {
    font-size: 0.55em;
    color: var(--lime);
    margin: 0 0.06em;
  }
  /* sparkline: fixed 120×32 box in the grid (nothing shifts when it draws), lime at 70%, mint end dot */
  .spark {
    width: 120px;
    height: 32px;
    margin-top: 10px;
    overflow: visible;
  }
  .spark__line {
    fill: none;
    stroke: rgba(198, 255, 74, 0.7);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark__end {
    fill: var(--mint);
    transition: opacity 300ms ease;
  }
  .about__label {
    font-size: 15px;
    font-weight: 560;
    margin-top: 8px;
  }
  .about__sub {
    font-size: 13px;
    color: var(--fg-2);
  }
  @media (min-width: 400px) {
    .about__stats {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .about__stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .about__stat {
      padding: 32px 24px 32px 0;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .about__stat + .about__stat {
      padding-left: 24px;
    }
    .about__stat:last-child {
      border-right: 0;
    }
  }
</style>

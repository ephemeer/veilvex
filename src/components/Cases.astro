---
import type { Content } from '../i18n/types';
import { pad2 } from '../i18n';
import SectionHead from './SectionHead.astro';
import CaseArt from './CaseArt.astro';
import CaseSheet from './CaseSheet.astro';
import Icon from './Icon.astro';
interface Props {
  t: Content;
}
const { t } = Astro.props;
const sheet = t.cases.sheet;
const filters = [
  ['all', t.cases.filters.all],
  ['web', t.cases.filters.web],
  ['app', t.cases.filters.app],
  ['ads', t.cases.filters.ads],
  ['design', t.cases.filters.design],
] as const;
---
<!-- With JS and motion on, src/scripts/arena.ts turns the grid below into the case arena (the reference's ring of
     neon frames): the container becomes a pinned stage (position: sticky) that travels through the empty
     `.cases__track` spacer, and the <li> cards are placed on a cylinder with CSS 3D transforms — same elements,
     same sheet opener. Without JS or under reduced motion nothing here changes: the spacer is empty and every
     `.is-arena` rule stays unmatched, so the plain grid is the fallback. -->
<section class="section cases is-collapsed" id="cases" data-cases-root>
  <div class="container cases__stage" data-arena-stage>
    <div class="cases__head">
      <SectionHead index="07" tag={t.cases.tag} title={t.cases.title} class="cases__sh" />
      <div class="filters reveal" role="group" aria-label={t.cases.tag} data-filters>
        {filters.map(([id, label]) => (
          <button type="button" class="filters__btn" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>
        ))}
        <!-- inverted copy of the row, clipped to the active button (duplicate + clip-path technique) -->
        <div class="filters__active" aria-hidden="true" data-active-layer>
          {filters.map(([id, label]) => (
            <span class="filters__btn" data-filter-copy={id}>{label}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Every card opens the case sheet (CaseSheet.astro, src/scripts/case-sheet.ts). The title is the
         button — its accessible name is the title, the <h3> keeps its heading role — and its ::after is
         stretched over the whole card, so the card is the target without nesting interactive elements.
         `id="case-N"` is the deep link (#case-N): a language switch keeps it, and without JS the browser
         at least scrolls to the card. -->
    <ul class="cases__grid" data-cases>
      {t.cases.items.map((c, i) => (
        <li class="card case reveal" id={`case-${i + 1}`} data-i={i} data-type={c.type} data-spotlight>
          <div class="case__art">
            <CaseArt type={c.type} idx={i} />
            <!-- information on hover (fine pointers and keyboard focus): a small data sheet over the dimmed art.
                 Decorative — the same facts are in the case sheet — so it is hidden from AT and takes no pointer. -->
            <dl class="case__facts" aria-hidden="true">
              <div class="case__fact"><dt>{sheet.direction}</dt><dd>{c.kind}</dd></div>
              <div class="case__fact"><dt>{sheet.tech}</dt><dd>{c.tags}</dd></div>
              <div class="case__fact"><dt>{sheet.result}</dt><dd>{c.result}</dd></div>
            </dl>
          </div>
          <div class="case__body">
            <div class="case__meta">
              <span class="num"><b>{pad2(i + 1)}</b></span>
              <span class="case__tags mono">{c.tags}</span>
            </div>
            <h3 class="case__title">
              <button type="button" class="case__open" aria-haspopup="dialog" aria-controls="case-sheet" data-case-open={i + 1}>
                {c.title}<Icon name="arrow-up-right" size={14} class="case__arrow" />
              </button>
            </h3>
            <p class="case__result">{c.result}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="cases__more-wrap">
      <button type="button" class="btn btn--secondary cases__more" data-cases-more>{t.cases.showAll}<Icon name="chevron" size={14} /></button>
    </div>
  </div>
  <div class="cases__track" data-arena-track aria-hidden="true"></div>
  <CaseSheet t={t} />
</section>
<style>
  .cases__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .cases__sh {
    margin-bottom: 0;
  }
  .filters {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.02);
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .filters__active {
    position: absolute;
    inset: 4px;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    border-radius: 999px;
    background: var(--fg);
    color: #0a0a0b;
    clip-path: inset(var(--t, 0) var(--r, 100%) var(--b, 0) var(--l, 0) round 999px);
    transition: clip-path 200ms var(--ease-out);
    pointer-events: none;
  }
  .filters__active .filters__btn {
    color: #0a0a0b;
  }
  .filters__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 560;
    color: var(--fg-2);
    white-space: nowrap;
    transition: color 160ms ease, transform 140ms var(--ease-out);
  }
  .filters__btn:active {
    transform: scale(0.98);
  }
  .cases__grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  .case {
    display: grid;
    grid-template-rows: auto 1fr;
    transition: border-color 200ms ease, background-color 200ms ease, opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  /* press feedback for the whole card (the button inside is being activated, so the card is :active too):
     scale(0.98) in 140ms, the release keeps the card's own 200ms */
  .case:active {
    transform: scale(0.98);
    transition-duration: 200ms, 200ms, 200ms, 140ms;
  }
  .case.is-out {
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
  }
  .case__art {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    overflow: hidden;
  }
  .case__art :global(.art) {
    transition: opacity 200ms ease;
  }
  /* the hover data sheet: three mono rows at the foot of the art, each rising 6px into place 30ms after the
     previous one (transitions, so a pointer that leaves mid-way simply reverses); a scrim keeps the text legible */
  .case__facts {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 5px;
    padding: 44px 16px 14px;
    pointer-events: none;
  }
  .case__facts::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 9, 10, 0), rgba(8, 9, 10, 0.8) 42%);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .case__fact {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 10px;
    align-items: start;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .case__fact dt {
    padding-top: 1px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .case__fact dd {
    color: var(--fg);
  }
  .case__body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .case__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
  }
  .case__tags {
    text-align: right;
    letter-spacing: 0.04em;
    font-size: 11.5px;
  }
  .case__title {
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  .case__open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-align: left;
  }
  /* the stretched target: the card (position: relative, overflow: hidden) is the containing block */
  .case__open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* the focus ring follows the card, inside its clipped edge */
  .case__open:focus-visible {
    outline: none;
  }
  .case__open:focus-visible::after {
    outline: 2px solid var(--lime);
    outline-offset: -3px;
    border-radius: calc(var(--r-lg) - 1px);
  }
  .case__title :global(.case__arrow) {
    color: var(--fg-3);
    transition: transform 200ms var(--ease-out), color 200ms ease;
  }
  .case__result {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.5;
    /* two lines reserved: every card keeps one height, so a filter never changes the row height
       (the cards that stay would otherwise snap by a line when their taller siblings leave or return) */
    min-height: 3em;
  }
  /* phones: show 6 cases, the rest behind a button (JS only) */
  .cases__more-wrap {
    display: none;
    margin-top: 16px;
  }
  .cases__more {
    width: 100%;
  }
  @media (max-width: 639px) {
    html.js .cases.is-collapsed .case:nth-child(n + 7) {
      display: none;
    }
    html.js .cases.is-collapsed .cases__more-wrap {
      display: block;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .case:hover :global(.case__arrow) {
      color: var(--lime);
      transform: translate(1px, -1px);
    }
    .filters__btn:hover {
      color: var(--fg);
    }
    /* information on hover — and on keyboard focus — the art dims, the data sheet enters row by row */
    .case:hover .case__art :global(.art),
    .case:focus-within .case__art :global(.art) {
      opacity: 0.55;
    }
    .case:hover .case__facts::before,
    .case:focus-within .case__facts::before {
      opacity: 1;
    }
    .case:hover .case__fact,
    .case:focus-within .case__fact {
      opacity: 1;
      transform: none;
    }
    .case:hover .case__fact:nth-child(2),
    .case:focus-within .case__fact:nth-child(2) {
      transition-delay: 30ms;
    }
    .case:hover .case__fact:nth-child(3),
    .case:focus-within .case__fact:nth-child(3) {
      transition-delay: 60ms;
    }
  }
  @media (min-width: 640px) {
    .cases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cases__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case.is-out,
    .case:active,
    .filters__btn:active,
    .case:hover :global(.case__arrow) {
      transform: none;
    }
    .filters__active {
      transition: none;
    }
    .case__fact {
      transform: none;
      transition: opacity 200ms ease;
    }
  }
</style>

<!-- The case arena (src/scripts/arena.ts). Global, not scoped: the script builds the stage chrome (mirror,
     floor, rays, headline, pagination) at runtime, so those elements carry no Astro scope attribute. Every
     rule hangs off `.cases.is-arena` / `.cases__grid.is-arena`, which only the script adds — with JS off or
     under reduced motion the scoped grid rules above are the whole story. -->
<style is:global>
  /* ---- geometry tokens: card 200×260 on a cylinder of radius 460px (neighbouring centres 240px apart at
     30° steps), eye 1400px away; phones 150×200 on 345px. The stage is the viewport below the header, capped
     at 780px; the section scrolls 180px per case (min 1600px) while the stage stays pinned. ---- */
  .cases.is-arena {
    --arena-w: 200px;
    --arena-h: 260px;
    --arena-r: 460px;
    --arena-persp: 1400px;
    --arena-span: 2160px;
    --arena-stage: min(100vh - var(--nav-h) - 24px, 780px);
    --arena-stage: min(100svh - var(--nav-h) - 24px, 780px);
  }
  .cases.is-arena .cases__stage {
    position: sticky;
    top: var(--nav-h);
    display: flex;
    flex-direction: column;
    height: var(--arena-stage);
  }
  /* a #case-N load: in flow until `load`, so the browser's own scroll to the card converges (arena.ts) */
  .cases.is-arena.is-booting .cases__stage {
    position: relative;
    top: 0;
  }
  .cases.is-arena .cases__track {
    height: var(--arena-span);
  }
  .cases.is-arena .cases__head {
    position: relative;
    z-index: 2;
    flex: none;
  }
  .cases.is-arena .filters {
    margin-bottom: 0;
  }
  .cases.is-arena .cases__more-wrap {
    display: none;
  }

  /* ---- the light: 7 rays and a beam converging at the top centre, a lime floor glow with a faint mint
     halo under the ring, a horizon line where the cards stand ---- */
  .arena__rays {
    position: absolute;
    inset: 0 0 auto;
    height: 58%;
    color: rgba(198, 255, 74, 0.06);
    pointer-events: none;
  }
  .arena__rays line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .arena__beam {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 42%;
    background: linear-gradient(180deg, rgba(198, 255, 74, 0.3), rgba(198, 255, 74, 0));
    pointer-events: none;
  }
  .arena {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  /* the same entrance as every other block (reveal-in: fade + 10px rise, 600ms), once, as one object */
  html.js .arena:not(.is-in) {
    opacity: 0;
  }
  html.js .arena.is-in {
    animation: reveal-in 600ms var(--ease-out-long) backwards;
  }
  /* the scene bleeds to the viewport edges and clips there (x only): the side cards leave the screen
     like on the reference instead of widening the page */
  .arena__scene {
    position: relative;
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: minmax(16px, 1fr) auto minmax(40px, 1.5fr);
    min-height: calc(var(--arena-h) + 56px);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: clip;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .arena__ring {
    position: relative;
    grid-row: 2;
    width: 100%;
    height: var(--arena-h);
  }
  .arena__floor {
    position: absolute;
    top: calc(100% - 24px);
    left: 50%;
    width: min(140vw, 1240px);
    height: 280px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 46% 68% at 50% 9%, rgba(198, 255, 74, 0.16), rgba(198, 255, 74, 0) 70%),
      radial-gradient(ellipse 72% 56% at 50% 4%, rgba(88, 230, 196, 0.05), rgba(88, 230, 196, 0) 70%);
    pointer-events: none;
  }
  .arena__horizon {
    position: absolute;
    top: 100%;
    left: 4%;
    right: 4%;
    height: 1px;
    background: linear-gradient(90deg, rgba(198, 255, 74, 0), rgba(198, 255, 74, 0.38) 28%, rgba(198, 255, 74, 0.38) 72%, rgba(198, 255, 74, 0));
    pointer-events: none;
  }

  /* ---- the ring: the <ul> is the 3D context. The stylesheet places each card from its `--i` and the ring's
     `--p` (continuous active index; angle = (i − p) × step); in motion the script scrubs one paused compositor
     animation per card and stand-in instead (arena.ts — a `--p` change on the ring would restyle the whole
     subtree every frame) and writes `--p` back once it settles. Nothing but transform/opacity changes per frame. ---- */
  .cases__grid.is-arena {
    position: absolute;
    inset: 0;
    display: block;
    perspective: var(--arena-persp);
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
    /* the context root's own plane (z = 0) would otherwise take every hit meant for the cards behind it */
    pointer-events: none;
  }
  .cases__grid.is-arena > .case {
    pointer-events: auto;
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--arena-w);
    height: var(--arena-h);
    margin: 0 0 0 calc(var(--arena-w) / -2);
    overflow: visible;
    border-color: rgba(198, 255, 74, 0.28);
    border-radius: var(--r-lg);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 7px),
      var(--surface);
    transform: translateZ(calc(-1 * var(--arena-r))) rotateY(calc((var(--i, 0) - var(--p, 0)) * var(--step, 30deg))) translateZ(var(--arena-r));
    backface-visibility: hidden;
    will-change: transform;
    transition: border-color 300ms ease, opacity 200ms var(--ease-out);
  }
  .cases__grid.is-arena > .case.is-active {
    border-color: rgba(198, 255, 74, 0.75);
  }
  /* neon glow: a pseudo with the shadow baked in, only its opacity moves (a transitioning box-shadow would repaint) */
  .cases__grid.is-arena > .case::before,
  .arena__ghost::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow:
      0 0 22px rgba(198, 255, 74, 0.42),
      0 0 70px rgba(198, 255, 74, 0.2),
      inset 0 0 18px rgba(198, 255, 74, 0.1);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }
  .cases__grid.is-arena > .case.is-active::before,
  .arena__ghost.is-active::before {
    opacity: 1;
  }
  .cases__grid.is-arena > .case .card__spot {
    display: none;
  }
  /* press feedback (scale .98, 140ms) and the filter glide (400ms) are animations the script runs on top of
     the placement; `.is-reflow` on the ring and the <ul> marks the glide for tests and tools */
  /* side cards: content at .35, the active card and a hovered card at full. At rest the active card shows its
     picture inside the neon frame (as the reference shows the project's media); the data sheet is the same
     hover / focus gesture as in the grid, so on phones the facts stay one tap away in the case sheet */
  .cases__grid.is-arena > .case > .case__art,
  .cases__grid.is-arena > .case > .case__body {
    opacity: 0.35;
    transition: opacity 300ms ease;
  }
  .cases__grid.is-arena > .case.is-active > .case__art,
  .cases__grid.is-arena > .case.is-active > .case__body {
    opacity: 1;
  }
  /* the card's type fits a 200px frame: a smaller body, title and result clamped to two lines */
  .cases__grid.is-arena .case__art {
    border-bottom-color: rgba(198, 255, 74, 0.12);
  }
  .cases__grid.is-arena .case__body {
    gap: 6px;
    padding: 12px 14px;
  }
  .cases__grid.is-arena .case__meta {
    gap: 8px;
  }
  .cases__grid.is-arena .case__tags {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10.5px;
  }
  .cases__grid.is-arena .case__title {
    font-size: 15px;
    line-height: 1.25;
  }
  .cases__grid.is-arena .case__open {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .cases__grid.is-arena .case__result {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: 0;
    font-size: 12px;
    line-height: 1.4;
  }
  .cases__grid.is-arena .case__facts {
    gap: 3px;
    padding: 30px 12px 10px;
  }
  .cases__grid.is-arena .case__fact {
    grid-template-columns: 62px 1fr;
    gap: 8px;
    font-size: 10px;
  }
  .cases__grid.is-arena .case__fact dt {
    font-size: 9px;
  }

  /* ---- the reflection: stand-ins (frame + glow + the art cloned once) on the same cylinder, each flipped in
     its own plane (scaleY(-1) keeps the facing, so backface culling still hides the far side), seen from the
     same eye (perspective-origin half a card above the box = the ring's centre), fading over 60% of the height ---- */
  .arena__mirror {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    height: var(--arena-h);
    perspective: var(--arena-persp);
    perspective-origin: 50% -50%;
    opacity: 0.28;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 60%);
    mask-image: linear-gradient(180deg, #000, transparent 60%);
    pointer-events: none;
  }
  .arena__ghost {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--arena-w);
    height: var(--arena-h);
    margin-left: calc(var(--arena-w) / -2);
    border: 1px solid rgba(198, 255, 74, 0.28);
    border-radius: var(--r-lg);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 7px),
      var(--surface);
    transform: translateZ(calc(-1 * var(--arena-r))) rotateY(calc((var(--i, 0) - var(--p, 0)) * var(--step, 30deg))) translateZ(var(--arena-r)) scaleY(-1);
    backface-visibility: hidden;
    will-change: transform;
    transition: border-color 300ms ease, opacity 200ms var(--ease-out);
  }
  .arena__ghost.is-active {
    border-color: rgba(198, 255, 74, 0.75);
  }
  .arena__ghost.is-out {
    opacity: 0;
  }
  .arena__ghost .art {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid rgba(198, 255, 74, 0.12);
    opacity: 0.7;
  }

  /* ---- the headline (bottom-left): ↳ + the active title + a mono line "kind · tags"; the title is decoded
     (decode.ts, 450ms) and slides 12px up behind its clip while the glyph scales .9 → 1 (300ms ease-out),
     the mono line crossfades 200ms between two stacked layers ---- */
  .arena__foot {
    position: relative;
    z-index: 2;
    flex: none;
    min-height: 118px;
  }
  /* a fixed box: full width of its column, two title lines with the text sitting on the lower one, the mono
     line below — decoding proportional text changes line widths and sometimes the line count, and nothing
     here may move with it; the block is anchored to the bottom, so a taller mono line grows upward */
  .arena__headline {
    --arena-fs: 28px;
    position: absolute;
    left: 0;
    bottom: 40px;
    width: 100%;
    pointer-events: none;
  }
  .arena__title {
    display: flex;
    align-items: flex-end;
    height: 2.16em;
    overflow: hidden;
    font-size: var(--arena-fs);
    font-weight: 540;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .arena__title h3 {
    font: inherit;
    letter-spacing: inherit;
    text-wrap: balance;
  }

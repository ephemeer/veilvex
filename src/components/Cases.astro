---
import type { Content } from '../i18n/types';
import { pad2 } from '../i18n';
import SectionHead from './SectionHead.astro';
import CaseArt from './CaseArt.astro';
import CaseSheet from './CaseSheet.astro';
import Icon from './Icon.astro';
interface Props {
  t: Content;
}
const { t } = Astro.props;
const sheet = t.cases.sheet;
const filters = [
  ['all', t.cases.filters.all],
  ['web', t.cases.filters.web],
  ['app', t.cases.filters.app],
  ['ads', t.cases.filters.ads],
  ['design', t.cases.filters.design],
] as const;
---
{/* With JS and motion on, src/scripts/arena.ts turns the grid below into the case arena (the reference's ring of
    neon frames): the container becomes a pinned stage (position: sticky) that travels through the empty
    `.cases__track` spacer, and the <li> cards are placed on a cylinder with CSS 3D transforms — same elements,
    same sheet opener. Without JS, under reduced motion or in a window too short for the stage nothing here
    changes: the spacer is empty and every `.is-arena` rule stays unmatched, so the plain grid is the fallback.
    (Astro comments: they do not ship.) */}
<section class="section cases is-collapsed" id="cases" data-cases-root>
  <div class="container cases__stage" data-arena-stage>
    <div class="cases__head">
      <SectionHead index="07" tag={t.cases.tag} title={t.cases.title} class="cases__sh" />
      <div class="filters reveal" role="group" aria-label={t.cases.tag} data-filters>
        {filters.map(([id, label]) => (
          <button type="button" class="filters__btn" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>
        ))}
        {/* inverted copy of the row, clipped to the active button (duplicate + clip-path technique) */}
        <div class="filters__active" aria-hidden="true" data-active-layer>
          {filters.map(([id, label]) => (
            <span class="filters__btn" data-filter-copy={id}>{label}</span>
          ))}
        </div>
      </div>
    </div>

    {/* Every card opens the case sheet (CaseSheet.astro, src/scripts/case-sheet.ts). The title is the
        button — its accessible name is the title, the <h3> keeps its heading role — and its ::after is
        stretched over the whole card, so the card is the target without nesting interactive elements.
        `id="case-N"` is the deep link (#case-N): a language switch keeps it, and without JS the browser
        at least scrolls to the card. */}
    <ul class="cases__grid" data-cases>
      {t.cases.items.map((c, i) => (
        <li class="card case reveal" id={`case-${i + 1}`} data-i={i} data-type={c.type} data-spotlight>
          <div class="case__art">
            <CaseArt type={c.type} idx={i} />
            {/* information on hover (fine pointers and keyboard focus): a small data sheet over the dimmed art.
                Decorative — the same facts are in the case sheet — so it is hidden from AT and takes no pointer. */}
            <dl class="case__facts" aria-hidden="true">
              <div class="case__fact"><dt>{sheet.direction}</dt><dd>{c.kind}</dd></div>
              <div class="case__fact"><dt>{sheet.tech}</dt><dd>{c.tags}</dd></div>
              <div class="case__fact"><dt>{sheet.result}</dt><dd>{c.result}</dd></div>
            </dl>
          </div>
          <div class="case__body">
            <div class="case__meta">
              <span class="num"><b>{pad2(i + 1)}</b></span>
              <span class="case__tags mono">{c.tags}</span>
            </div>
            <h3 class="case__title">
              <button type="button" class="case__open" aria-haspopup="dialog" aria-controls="case-sheet" data-case-open={i + 1}>
                {c.title}<Icon name="arrow-up-right" size={14} class="case__arrow" />
              </button>
            </h3>
            <p class="case__result">{c.result}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="cases__more-wrap">
      <button type="button" class="btn btn--secondary cases__more" data-cases-more>{t.cases.showAll}<Icon name="chevron" size={14} /></button>
    </div>
  </div>
  <div class="cases__track" data-arena-track aria-hidden="true"></div>
  <CaseSheet t={t} />
</section>
<style>
  .cases__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .cases__sh {
    margin-bottom: 0;
  }
  .filters {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.02);
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .filters__active {
    position: absolute;
    inset: 4px;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    border-radius: 999px;
    background: var(--fg);
    color: #0a0a0b;
    clip-path: inset(var(--t, 0) var(--r, 100%) var(--b, 0) var(--l, 0) round 999px);
    transition: clip-path 200ms var(--ease-out);
    pointer-events: none;
  }
  .filters__active .filters__btn {
    color: #0a0a0b;
  }
  .filters__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 560;
    color: var(--fg-2);
    white-space: nowrap;
    transition: color 160ms ease, transform 140ms var(--ease-out);
  }
  .filters__btn:active {
    transform: scale(0.98);
  }
  .cases__grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  .case {
    display: grid;
    grid-template-rows: auto 1fr;
    transition: border-color 200ms ease, background-color 200ms ease, opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  /* press feedback for the whole card (the button inside is being activated, so the card is :active too):
     scale(0.98) in 140ms, the release keeps the card's own 200ms */
  .case:active {
    transform: scale(0.98);
    transition-duration: 200ms, 200ms, 200ms, 140ms;
  }
  .case.is-out {
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
  }
  .case__art {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    overflow: hidden;
  }
  .case__art :global(.art) {
    transition: opacity 200ms ease;
  }
  /* the hover data sheet: three mono rows at the foot of the art, each rising 6px into place 30ms after the
     previous one (transitions, so a pointer that leaves mid-way simply reverses); a scrim keeps the text legible */
  .case__facts {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 5px;
    padding: 44px 16px 14px;
    pointer-events: none;
  }
  .case__facts::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 9, 10, 0), rgba(8, 9, 10, 0.8) 42%);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .case__fact {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 10px;
    align-items: start;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .case__fact dt {
    padding-top: 1px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .case__fact dd {
    color: var(--fg);
  }
  .case__body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .case__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
  }
  .case__tags {
    text-align: right;
    letter-spacing: 0.04em;
    font-size: 11.5px;
  }
  .case__title {
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.015em;
  }
  .case__open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-align: left;
  }
  /* the stretched target: the card (position: relative, overflow: hidden) is the containing block */
  .case__open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* the focus ring follows the card, inside its clipped edge */
  .case__open:focus-visible {
    outline: none;
  }
  .case__open:focus-visible::after {
    outline: 2px solid var(--lime);
    outline-offset: -3px;
    border-radius: calc(var(--r-lg) - 1px);
  }
  .case__title :global(.case__arrow) {
    color: var(--fg-3);
    transition: transform 200ms var(--ease-out), color 200ms ease;
  }
  .case__result {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.5;
    /* two lines reserved: every card keeps one height, so a filter never changes the row height
       (the cards that stay would otherwise snap by a line when their taller siblings leave or return) */
    min-height: 3em;
  }
  /* phones: show 6 cases, the rest behind a button (JS only) */
  .cases__more-wrap {
    display: none;
    margin-top: 16px;
  }
  .cases__more {
    width: 100%;
  }
  @media (max-width: 639px) {
    html.js .cases.is-collapsed .case:nth-child(n + 7) {
      display: none;
    }
    html.js .cases.is-collapsed .cases__more-wrap {
      display: block;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .case:hover :global(.case__arrow) {
      color: var(--lime);
      transform: translate(1px, -1px);
    }
    .filters__btn:hover {
      color: var(--fg);
    }
    /* information on hover — and on keyboard focus — the art dims, the data sheet enters row by row */
    .case:hover .case__art :global(.art),
    .case:focus-within .case__art :global(.art) {
      opacity: 0.55;
    }
    .case:hover .case__facts::before,
    .case:focus-within .case__facts::before {
      opacity: 1;
    }
    .case:hover .case__fact,
    .case:focus-within .case__fact {
      opacity: 1;
      transform: none;
    }
    .case:hover .case__fact:nth-child(2),
    .case:focus-within .case__fact:nth-child(2) {
      transition-delay: 30ms;
    }
    .case:hover .case__fact:nth-child(3),
    .case:focus-within .case__fact:nth-child(3) {
      transition-delay: 60ms;
    }
  }
  @media (min-width: 640px) {
    .cases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cases__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case.is-out,
    .case:active,
    .filters__btn:active,
    .case:hover :global(.case__arrow) {
      transform: none;
    }
    .filters__active {
      transition: none;
    }
    .case__fact {
      transform: none;
      transition: opacity 200ms ease;
    }
  }
</style>

{/* The case arena (src/scripts/arena.ts). Global, not scoped: the script builds the stage chrome (rays, rim,
    mirror, headline, pager) at runtime, so those elements carry no Astro scope attribute. Every rule hangs off
    `.cases.is-arena-pending` / `.cases.is-arena` / `.cases__grid.is-arena` or off the elements the script builds,
    all of which only the script adds — with JS off, under reduced motion or in a window too short for the stage
    the scoped grid rules above are the whole story. */}
<style is:global>
  /* ---- geometry: card size is written by the script per resize (scale 0.6–1.3 of 200×260 / 150×200); the
     radius, the eye distance and the per-card angles live in the script's transforms. The stage is the viewport
     below the header; the foot under the scene is reserved for the headline and the pager (its height is
     arena.ts FOOT). The variables live on the arena's own box, not on the section: a custom property set on
     an ancestor re-styles every element below it ---- */
  .arena {
    --arena-w: 200px;
    --arena-h: 260px;
    --arena-foot: 76px;
    --arena-tick: 10px;
  }
  .cases.is-arena .cases__stage {
    position: sticky;
    top: var(--nav-h);
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
  }
  /* before the deferred mount (arena.ts): the stage already one viewport tall and the track at its length, so the
     mount moves nothing below the section; the grid waits inside, clipped (the mount comes 1.5 viewports early) */
  .cases.is-arena-pending .cases__stage {
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    overflow: clip;
  }
  /* a #case-N load: in flow until `load`, so the browser's own scroll to the card converges (arena.ts) */
  .cases.is-arena.is-booting .cases__stage {
    position: relative;
    top: 0;
  }
  .cases.is-arena .cases__head {
    position: relative;
    z-index: 2;
    flex: none;
    padding-top: 12px;
    row-gap: 14px;
  }
  /* heading and filters on one row: the section head's own bottom margin would make the row 72px taller */
  .cases.is-arena .cases__sh {
    gap: 10px;
    margin-bottom: 0;
  }
  .cases.is-arena .filters {
    margin-bottom: 0;
  }
  /* the mount's preflight (arena.ts) measures the stage and the head with the section in arena mode: the grid
     sits out of that layout until the script has turned it into the ring */
  .cases.is-arena .cases__more-wrap,
  .cases.is-arena .cases__grid:not(.is-arena) {
    display: none;
  }

  /* ---- the light: rays and three ceiling lines converging at the top centre (static), a vertical beam ---- */
  .arena__rays {
    position: absolute;
    top: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    max-width: none; /* global.css caps svg at 100% of the stage */
    height: 44%;
    color: rgba(198, 255, 74, 0.06);
    pointer-events: none;
  }
  .arena__rays line {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .arena__rays .arena__ceil {
    stroke: rgba(255, 255, 255, 0.035);
  }
  .arena__beam {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 40%;
    background: linear-gradient(180deg, rgba(198, 255, 74, 0.3), rgba(198, 255, 74, 0));
    pointer-events: none;
  }
  .arena {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  /* the same entrance as every other block (reveal-in: fade + 10px rise, 600ms), once, as one object */
  html.js .arena:not(.is-in) {
    opacity: 0;
  }
  html.js .arena.is-in {
    animation: reveal-in 600ms var(--ease-out-long) backwards;
  }
  /* the scene bleeds to the viewport edges and is contained: transform changes inside never reach the page's
     layout or paint, and the side cards leave the screen at its edges */
  .arena__scene {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    margin-inline: calc(50% - 50vw);
    display: grid;
    grid-template-rows: minmax(0, 1fr) var(--arena-h) minmax(calc(var(--arena-h) * 0.62), 1.6fr);
    contain: layout paint;
    overflow: clip;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* the ring's box: the eye sits at 30% of the cards' height, so the base of the ring curves up toward the sides */
  .arena__ring {
    position: relative;
    grid-row: 2;
    perspective: 2800px;
    perspective-origin: 50% 30%;
  }
  .arena__floor {
    position: absolute;
    top: calc(100% - var(--arena-h) * 0.12);
    left: 50%;
    width: calc(var(--arena-w) * 7);
    height: calc(var(--arena-h) * 1.15);
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 46% 60% at 50% 8%, rgba(198, 255, 74, 0.16), rgba(198, 255, 74, 0) 70%),
      radial-gradient(ellipse 72% 52% at 50% 4%, rgba(88, 230, 196, 0.05), rgba(88, 230, 196, 0) 70%);
    pointer-events: none;
  }
  /* the glowing rim along the base (static SVG, drawn by the script through the projected bottom points) */
  .arena__rim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .arena__rim path {
    fill: none;
    stroke: var(--lime);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arena__rim-haze {
    stroke-width: 16px;
    stroke-opacity: 0.05;
  }
  .arena__rim-glow {
    stroke-width: 6px;
    stroke-opacity: 0.12;
  }
  .arena__rim-line {
    stroke-width: 1.5px;
    stroke-opacity: 0.7;
  }

  /* ---- the ring: the <ul> is the 3D context that turns (translateZ(−R) rotateY(−p·step), written per frame);
     each card sits at a static rotateY(slot·step) translateZ(R). Nothing else changes per frame. ---- */
  .cases__grid.is-arena {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    will-change: transform;
    /* the context root's own plane (z = 0) would otherwise take every hit meant for the cards behind it */
    pointer-events: none;
  }
  .cases__grid.is-arena > .case {
    pointer-events: auto;
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--arena-w);
    height: var(--arena-h);
    margin: 0 0 0 calc(var(--arena-w) / -2);
    grid-template-columns: minmax(0, 1fr);
    overflow: visible;
    border-color: rgba(198, 255, 74, 0.45);
    border-radius: var(--r-lg);
    box-shadow: 0 0 14px rgba(198, 255, 74, 0.1);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 7px),
      var(--surface);
    backface-visibility: hidden;
  }
  /* only the filter fade transitions on the card itself: its transform is the placement (inline), and the frame
     never changes colour — the light is a layer of its own */
  .cases__grid.is-arena > .case,
  .cases__grid.is-arena > .case:active {
    transition: opacity 200ms var(--ease-out);
  }
  .cases__grid.is-arena > .case:hover {
    border-color: rgba(198, 255, 74, 0.45);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 7px),
      var(--surface);
  }
  /* the light of the front frame: a full-alpha border and a tight glow on a pseudo layer, opacity only (150ms).
     The glow stays tight (as in the reference): a wide blur in 24 turning layers costs frames to raster */
  .cases__grid.is-arena > .case::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(198, 255, 74, 0.95);
    border-radius: inherit;
    box-shadow:
      0 0 18px rgba(198, 255, 74, 0.45),
      inset 0 0 14px rgba(198, 255, 74, 0.12);
    opacity: 0;
    transition: opacity 150ms var(--ease-out);
    pointer-events: none;
  }
  .cases__grid.is-arena > .case.is-active::before {
    opacity: 1;
  }
  .cases__grid.is-arena > .case .card__spot {
    display: none;
  }
  /* side cards: the art dimmed, the text hidden; the front card and a hovered side card show it (150ms) */
  .cases__grid.is-arena > .case > .case__art {
    border-radius: calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px) 0 0;
    border-bottom-color: rgba(198, 255, 74, 0.12);
    opacity: 0.5;
    transition: opacity 150ms var(--ease-out);
  }
  .cases__grid.is-arena > .case > .case__body {
    opacity: 0;
    transition: opacity 150ms var(--ease-out);
  }
  .cases__grid.is-arena > .case.is-active > .case__art,
  .cases__grid.is-arena > .case.is-active > .case__body,
  .cases__grid.is-arena > .case.is-hover > .case__body {
    opacity: 1;
  }
  .cases__grid.is-arena > .case.is-hover > .case__art {
    opacity: 0.8;
  }
  /* the art's labels: SVG text under the turning ring would be laid out again every frame, so the script puts
     them in HTML over the art (same place, the art's 11 units, same colours) and the SVG text steps aside */
  .cases__grid.is-arena .art text {
    display: none;
  }
  .cases__grid.is-arena .arena__label {
    position: absolute;
    font-family: var(--mono);
    font-size: calc((var(--arena-w) - 2px) * 11 / 320);
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--fg-2);
    transform: translateY(-0.85em);
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .cases__grid.is-arena .arena__label--mid {
    transform: translate(-50%, -0.85em);
  }
  /* exact where supported: the box trimmed to cap height and the alphabetic baseline, lifted by its height */
  @supports (text-box: trim-both cap alphabetic) {
    .cases__grid.is-arena .arena__label {
      text-box: trim-both cap alphabetic;
      transform: translateY(-100%);
    }
    .cases__grid.is-arena .arena__label--mid {
      transform: translate(-50%, -100%);
    }
  }
  .cases__grid.is-arena .arena__label--lime {
    color: var(--lime);
    font-weight: 600;
  }
  /* the data sheet is the front card's hover / focus gesture only */
  .cases__grid.is-arena > .case:not(.is-active) .case__facts {
    visibility: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    /* a hover counts only after a real pointer move (.is-hover, arena.ts): a card sliding under a resting
       pointer does not open its data sheet */
    .cases__grid.is-arena > .case:hover:not(.is-hover):not(:focus-within) .case__fact {
      opacity: 0;
      transform: translateY(6px);
    }
    .cases__grid.is-arena > .case:hover:not(.is-hover):not(:focus-within) .case__facts::before {
      opacity: 0;
    }
    .cases__grid.is-arena > .case:hover .arena__label,
    .cases__grid.is-arena > .case:focus-within .arena__label {
      opacity: 0.55;
    }
    .cases__grid.is-arena > .case:hover:not(.is-hover):not(:focus-within) .case__art .art,
    .cases__grid.is-arena > .case:hover:not(.is-hover):not(:focus-within) .arena__label {
      opacity: 1;
    }
  }
  /* the card's type fits a 200px frame: a smaller body, title and result clamped to two lines; the body's
     single column may shrink below its nowrap tag line, which then ends in an ellipsis; its rows do not stretch
     (a stretched row would show the clamped result's third line) */
  .cases__grid.is-arena .case__body {
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 6px;
    padding: 12px 14px;
  }
  .cases__grid.is-arena .case__meta {

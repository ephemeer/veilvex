---
/* One distinct line-art illustration per case (no external images, deterministic). */
import type { CaseType } from '../i18n/types';
interface Props {
  type: CaseType;
  idx: number;
  /** Prefix for the SVG ids (pattern, gradient): the same art is rendered twice on a page — in the
   *  card grid and inside the case sheet — and <defs> ids must stay unique per document. */
  idPrefix?: string;
}
const { type, idx, idPrefix = '' } = Astro.props;
const gridId = `${idPrefix}g${idx}`;
const tintId = `${idPrefix}t${idx}`;
// bar charts derived from the real case numbers
const bars95 = [18, 30, 42, 55, 66, 80, 95];
const bars90 = [12, 22, 38, 47, 61, 74, 90];
const scale = (v: number) => (v / 100) * 110;
// a very soft radial tint by case type behind the line art (static), its centre moving round the corners
const TINT: Record<CaseType, [string, number]> = { web: ['#c6ff4a', 0.06], app: ['#58e6c4', 0.06], ads: ['#c6ff4a', 0.08], design: ['#58e6c4', 0.05] };
const [tintColor, tintAlpha] = TINT[type];
const SPOTS = [
  [0.78, 0.22],
  [0.24, 0.3],
  [0.72, 0.74],
  [0.3, 0.72],
] as const;
const [tx, ty] = SPOTS[idx % 4] ?? SPOTS[0];
---
<svg class="art" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={gridId} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    </pattern>
    <radialGradient id={tintId} cx={tx} cy={ty} r="0.7">
      <stop offset="0" stop-color={tintColor} stop-opacity={tintAlpha} />
      <stop offset="1" stop-color={tintColor} stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="320" height="200" fill={`url(#${tintId})`} />
  <rect width="320" height="200" fill={`url(#${gridId})`} />

  {idx === 0 && (
    /* construction marketplace: orders ⇄ bids */
    <g transform="translate(34 36)">
      <rect x="0" y="0" width="112" height="128" rx="8" class="art__stroke" />
      <rect x="12" y="14" width="60" height="8" rx="3" class="art__fill" />
      {[36, 58, 80, 102].map((y) => (
        <g>
          <rect x="12" y={y} width="88" height="12" rx="4" class="art__stroke" />
          <rect x="18" y={y + 4} width="34" height="4" rx="2" class="art__dim" />
        </g>
      ))}
      <rect x="140" y="0" width="112" height="128" rx="8" class="art__stroke" />
      <rect x="152" y="14" width="48" height="8" rx="3" class="art__fill" />
      {[36, 58, 80].map((y, i) => (
        <rect x="152" y={y} width="88" height="12" rx="4" class={i === 1 ? 'art__lime' : 'art__stroke'} />
      ))}
      <path d="M118 60h16m0 0-5-5m5 5-5 5M134 80h-16m0 0 5-5m-5 5 5 5" class="art__lime" />
      <circle cx="240" cy="14" r="5" class="art__lime-fill" />
    </g>
  )}
  {idx === 1 && (
    /* english courses: 95 leads */
    <g transform="translate(44 36)">
      <path d="M0 130h232" class="art__stroke" />
      {bars95.map((v, i) => (
        <rect x={10 + i * 32} y={130 - scale(v)} width="20" height={scale(v)} rx="3" class={i === 6 ? 'art__lime-fill' : 'art__fill'} />
      ))}
      <rect x="170" y="2" width="52" height="20" rx="10" class="art__lime" />
      <text x="196" y="16" text-anchor="middle" class="art__text art__text--lime">95</text>
    </g>
  )}
  {idx === 2 && (
    /* provider portal: coverage map */
    <g transform="translate(40 30)">
      <rect x="0" y="0" width="240" height="140" rx="8" class="art__stroke" />
      <path d="M0 46h240M0 96h240M70 0v140M150 0v140" class="art__stroke" opacity="0.6" />
      <path d="M20 120 60 70l40 30 36-54 44 40 40-26" class="art__dim-line" />
      <circle cx="136" cy="76" r="42" class="art__lime" stroke-dasharray="4 5" />
      <circle cx="136" cy="76" r="22" fill="rgba(198,255,74,0.12)" />
      <path d="M136 50c-9 0-16 7-16 16 0 12 16 28 16 28s16-16 16-28c0-9-7-16-16-16z" class="art__lime-fill" />
      <circle cx="136" cy="66" r="5" fill="#08090a" />
    </g>
  )}
  {idx === 3 && (
    /* personal brand: 90 leads under $1 */
    <g transform="translate(40 32)">
      <circle cx="36" cy="36" r="24" class="art__stroke" />
      <circle cx="36" cy="30" r="8" class="art__fill" />
      <path d="M20 54c4-9 10-12 16-12s12 3 16 12" class="art__fill" />
      <rect x="76" y="14" width="80" height="8" rx="3" class="art__fill" />
      <rect x="76" y="30" width="50" height="6" rx="3" class="art__dim" />
      {bars90.map((v, i) => (
        <rect x={76 + i * 24} y={136 - v * 0.7} width="14" height={v * 0.7} rx="3" class={i === 6 ? 'art__lime-fill' : 'art__fill'} />
      ))}
      <path d="M0 136h240" class="art__stroke" />
      <rect x="184" y="8" width="56" height="22" rx="11" class="art__lime" />
      <text x="212" y="23" text-anchor="middle" class="art__text art__text--lime">&lt; $1</text>
    </g>
  )}
  {idx === 4 && (
    /* corporate site: hero + gallery of completed objects */
    <g transform="translate(40 30)">
      <rect x="0" y="0" width="240" height="140" rx="8" class="art__stroke" />
      <path d="M0 22h240" class="art__stroke" />
      <rect x="14" y="36" width="92" height="10" rx="3" class="art__fill" />
      <rect x="14" y="52" width="60" height="6" rx="3" class="art__dim" />
      <rect x="14" y="66" width="46" height="16" rx="5" class="art__lime" />
      <rect x="130" y="34" width="96" height="52" rx="5" class="art__stroke" />
      <path d="M130 86 160 60l20 16 14-10 32 20" class="art__stroke" />
      {[14, 88, 162].map((x) => (
        <rect x={x} y="98" width="64" height="30" rx="4" class="art__stroke" />
      ))}
    </g>
  )}
  {idx === 5 && (
    /* restaurant menu: sections, items, prices, RU/AZ */
    <g transform="translate(44 30)">
      <rect x="0" y="0" width="232" height="140" rx="8" class="art__stroke" />
      <rect x="14" y="14" width="56" height="8" rx="3" class="art__lime-fill" />
      <rect x="166" y="10" width="52" height="16" rx="8" class="art__stroke" />
      <rect x="170" y="14" width="22" height="8" rx="4" class="art__lime-fill" />
      {[38, 54, 70, 86, 102, 118].map((y, i) => (
        <g>
          <rect x="14" y={y} width={70 + (i % 3) * 14} height="6" rx="3" class="art__dim" />
          <path d={`M${96 + (i % 3) * 14} ${y + 3}H184`} class="art__stroke" stroke-dasharray="2 4" />
          <rect x="194" y={y} width="24" height="6" rx="3" class="art__fill" />
        </g>
      ))}
    </g>
  )}
  {idx === 6 && (
    /* massage studio: 80 bookings in 5 days */
    <g transform="translate(48 30)">
      {Array.from({ length: 5 }, (_, r) => Array.from({ length: 7 }, (_, c) => {
        const lit = [3, 5, 9, 10, 12, 16, 18, 19, 23, 24, 26, 30, 31, 33].includes(r * 7 + c);
        return <rect x={c * 32} y={r * 26} width="26" height="20" rx="4" class={lit ? 'art__lime-fill' : 'art__stroke'} opacity={lit ? 0.85 : 1} />;
      }))}
      <rect x="0" y="-4" width="60" height="18" rx="9" class="art__lime" transform="translate(166 -12)" />
      <text x="196" y="-5" text-anchor="middle" class="art__text art__text--lime" transform="translate(0 6)">80</text>
    </g>
  )}
  {idx === 7 && (
    /* industrial supplier: catalogue + certificate */
    <g transform="translate(40 30)">
      {Array.from({ length: 6 }, (_, i) => (
        <g transform={`translate(${(i % 3) * 82} ${Math.floor(i / 3) * 70})`}>
          <rect x="0" y="0" width="70" height="58" rx="6" class="art__stroke" />
          <rect x="18" y="10" width="34" height="24" rx="4" class="art__dim" />
          <rect x="10" y="42" width="50" height="5" rx="2.5" class="art__fill" />
        </g>
      ))}
      <circle cx="212" cy="126" r="22" fill="#08090a" class="art__lime" />
      <path d="M203 126l6 6 12-13" class="art__lime" stroke-width="2.2" />
    </g>
  )}
  {idx === 8 && (
    /* oil & gas laboratories: equipment specs */
    <g transform="translate(40 28)">
      <path d="M44 6h28v40l26 56c4 9-2 20-12 20H30c-10 0-16-11-12-20l26-56z" class="art__stroke" />
      <path d="M34 104h48" class="art__lime" />
      <path d="M30 118h56" class="art__lime" opacity="0.5" />
      <rect x="120" y="6" width="120" height="124" rx="8" class="art__stroke" />
      <rect x="134" y="20" width="60" height="8" rx="3" class="art__fill" />
      {[42, 60, 78, 96].map((y, i) => (
        <g>
          <rect x="134" y={y} width="40" height="5" rx="2.5" class="art__dim" />
          <rect x="190" y={y - 2} width={36 - i * 6} height="9" rx="3" class={i === 0 ? 'art__lime-fill' : 'art__fill'} />
        </g>
      ))}
      <text x="134" y="122" class="art__text">25 y</text>
    </g>
  )}
  {idx === 9 && (
    /* manufacturing: 90-year timeline */
    <g transform="translate(36 40)">
      <path d="M0 84h248" class="art__stroke" />
      {[0, 62, 124, 186, 248].map((x, i) => (
        <g>
          <path d={`M${x} 78v12`} class="art__stroke" />
          <rect x={x - 14} y="96" width="28" height="6" rx="3" class="art__dim" />
          {i < 4 && <rect x={x + 10} y={60 - i * 10} width="40" height={24 + i * 10} class="art__stroke" />}
        </g>
      ))}
      <circle cx="248" cy="84" r="7" class="art__lime-fill" />
      <path d="M232 30h32l-16-14z" class="art__lime-fill" />
      <path d="M214 60h40M214 70h28" class="art__stroke" />
    </g>
  )}
  {idx === 10 && (
    /* restaurant visiting card: #1 in search */
    <g transform="translate(40 30)">
      <rect x="0" y="0" width="240" height="28" rx="14" class="art__stroke" />
      <circle cx="18" cy="14" r="5" class="art__stroke" />
      <path d="M22 18l4 4" class="art__stroke" />
      <rect x="34" y="11" width="110" height="6" rx="3" class="art__dim" />
      <rect x="0" y="46" width="240" height="94" rx="8" class="art__stroke" />
      <rect x="14" y="60" width="130" height="9" rx="3" class="art__lime-fill" />
      <rect x="14" y="76" width="90" height="5" rx="2.5" class="art__fill" />
      <rect x="14" y="92" width="200" height="5" rx="2.5" class="art__dim" />
      <rect x="14" y="104" width="170" height="5" rx="2.5" class="art__dim" />
      <rect x="14" y="116" width="120" height="5" rx="2.5" class="art__dim" />
      <rect x="196" y="58" width="30" height="18" rx="9" class="art__lime" />
      <text x="211" y="71" text-anchor="middle" class="art__text art__text--lime">#1</text>
    </g>
  )}
  {idx === 11 && (
    /* print menu booklet: two A4 pages */
    <g transform="translate(56 22)">
      <rect x="22" y="14" width="104" height="146" rx="4" class="art__stroke" opacity="0.5" transform="rotate(-6 74 87)" />
      <rect x="0" y="0" width="104" height="146" rx="4" fill="#0b0c0e" class="art__stroke" />
      <rect x="12" y="12" width="44" height="8" rx="3" class="art__lime-fill" />
      {[32, 44, 56, 68, 80, 92, 104, 116, 128].map((y, i) => (
        <rect x="12" y={y} width={i % 4 === 0 ? 36 : 80} height="4" rx="2" class={i % 4 === 0 ? 'art__fill' : 'art__dim'} />
      ))}
      <rect x="128" y="0" width="104" height="146" rx="4" fill="#0b0c0e" class="art__stroke" />
      <rect x="140" y="12" width="44" height="8" rx="3" class="art__lime-fill" />
      {[32, 44, 56, 68, 80, 92, 104, 116, 128].map((y, i) => (
        <rect x="140" y={y} width={i % 4 === 0 ? 36 : 80} height="4" rx="2" class={i % 4 === 0 ? 'art__fill' : 'art__dim'} />
      ))}
      <path d="M116 0v146" class="art__stroke" stroke-dasharray="3 4" />
    </g>
  )}
  {idx > 11 && (
    /* fallback for any extra case by type */
    <g transform="translate(40 34)">
      <rect x="0" y="0" width="240" height="132" rx="8" class="art__stroke" />
      <rect x="18" y="20" width="92" height="10" rx="3" class="art__fill" />
      <rect x="18" y="40" width="150" height="6" rx="3" class="art__dim" />
      <rect x="18" y="72" width="64" height="20" rx="6" class={type === 'ads' ? 'art__lime-fill' : 'art__lime'} />
    </g>
  )}
</svg>
<style>
  .art {
    width: 100%;
    height: 100%;
    display: block;
  }
  .art__stroke {
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.2;
  }
  .art__dim {
    fill: rgba(255, 255, 255, 0.12);
  }
  .art__dim-line {
    fill: none;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .art__fill {
    fill: rgba(255, 255, 255, 0.22);
  }
  .art__lime {
    fill: none;
    stroke: var(--lime);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art__lime-fill {
    fill: var(--lime);
  }
  .art__text {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--fg-2);
    letter-spacing: 0.04em;
  }
  .art__text--lime {
    fill: var(--lime);
    font-weight: 600;
  }
</style>

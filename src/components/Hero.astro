---
import type { Content, Lang } from '../i18n/types';
import { localePath } from '../i18n';
import Icon from './Icon.astro';
import Mock from './Mock.astro';

interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
const home = localePath(lang, '/');
// Split the headline into lines → words for the masked word reveal.
const lines = t.hero.title.split('\n').map((l) => l.split(' ').filter(Boolean));
let wordIndex = 0;
---

<section class="hero" id="top" data-hero>
  <div class="hero__aurora" aria-hidden="true" data-ambient data-aurora>
    <i class="aurora aurora--a" data-aurora-peak="0.18" data-aurora-mid="0.05"></i>
    <i class="aurora aurora--b" data-aurora-peak="0.16" data-aurora-mid="0.05"></i>
    <i class="aurora aurora--c" data-aurora-peak="0.10" data-aurora-mid="0.03"></i>
  </div>
  <div class="bg-glow" aria-hidden="true"></div>
  <canvas class="hero__field" data-field aria-hidden="true"></canvas>
  <div class="bg-grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <a class="hero__badge" href={`${home}#geo`}>
      <span class="dot" aria-hidden="true"></span>
      <span class="hero__badge-text">{t.hero.badge}</span>
      <span class="hero__badge-link">{t.hero.badgeLink} <Icon name="arrow" size={12} /></span>
    </a>

    <h1 class="h1 hero__title">
      {lines.map((words, li) => (
        <span class="hero__line">
          {words.map((w) => (
            <><span class="w"><span class={`w__in${li === lines.length - 1 ? ' w__in--accent' : ''}`} data-i={wordIndex++}>{w}</span></span>{' '}</>
          ))}
          {li < lines.length - 1 && <br class="br-desktop" />}
        </span>
      ))}
    </h1>

    <p class="lead hero__lead">{t.hero.lead}</p>

    <div class="hero__cta">
      <a href={`${home}#contact`} class="btn btn--primary btn--lg btn--swap">
        <span class="btn__label" data-text={t.hero.primary}><span>{t.hero.primary}</span></span>
        <Icon name="arrow-turn" size={16} />
      </a>
      <a href={`${home}#services`} class="btn btn--secondary btn--lg btn--swap"><span class="btn__label" data-text={t.hero.secondary}><span>{t.hero.secondary}</span></span></a>
    </div>

    <ul class="hero__chips" aria-label={t.hero.eyebrow}>
      {t.hero.chips.map((c, i) => (
        <li class="hero__chip" data-i={i}>
          <span class="hero__chip-n mono">0{i + 1}</span>
          <span class="hero__chip-t">{c.title}</span>
          <span class="hero__chip-s">{c.sub}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="container hero__mock">
    <Mock t={t} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* own stacking context: the z-index:-1 light layers (aurora, .bg-glow, .bg-grid) paint above the
       body's opaque background — <html> has a background too, so body's is not the canvas and would
       otherwise cover them — and below the hero's content */
    isolation: isolate;
    padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 88px));
    padding-bottom: clamp(48px, 6vw, 80px);
    overflow: clip;
  }
  .hero__inner {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .hero__badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    min-height: 32px;
    padding: 5px 12px 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.03);
    font-size: 13px;
    font-weight: 520;
    color: var(--fg-2);
    transition: border-color 160ms ease, color 160ms ease, transform 140ms var(--ease-out);
  }
  .hero__badge:active {
    transform: scale(0.98);
  }
  .hero__badge-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--fg);
  }
  .hero__badge-link :global(.icon) {
    transition: transform 160ms var(--ease-out);
  }
  .hero__title {
    /* 13em = 20ch of Inter at this weight. Not `ch`: the fallback font's "0" is 12% narrower, so a
       ch-based limit would re-wrap the headline (3 lines → 2) when Inter arrives */
    max-width: 13em;
  }
  .hero__line {
    display: inline;
  }
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .w__in {
    display: inline-block;
  }
  /* Gradient accent on the last line (lime → mint, clipped to the glyphs). Each word is its own masked
     box for the word reveal, so each would repeat the gradient: accent.ts stretches one gradient across
     the whole line (background-size/position). The padding mirrors .w so descenders keep their colour
     inside the mask; the negative margin keeps the line box where it was. */
  .w__in--accent {
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
    color: transparent;
    background: linear-gradient(90deg, var(--lime) 0%, var(--lime) 28%, var(--mint) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hero__lead {
    max-width: 560px;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 8px;
  }
  .hero__chip {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 10px;
    align-items: baseline;
    font-size: 14px;
  }
  .hero__chip-n {
    grid-row: span 2;
    color: var(--lime);
  }
  .hero__chip-t {
    font-weight: 560;
  }
  .hero__chip-s {
    color: var(--fg-2);
    font-size: 13px;
  }
  .hero__mock {
    margin-top: clamp(40px, 6vw, 64px);
  }

  /* ---- aurora: three slow light fields (lime, mint, lime) behind the hero ----
     Pure radial gradients (no filter layers), peak alpha .18 / .16 / .10 falling to ≤ 5% at 55% of the
     radius, placed in the empty right half on desktop and above the headline / beside the CTA on
     phones, so under the lead paragraph the wash stays below 8% (tests/e2e/visuals.test.mjs checks the
     geometry). Drift is transform-only (translate + scale, 34–44s, alternate; ease-in-out is right for
     continuous ambient motion). ambient.ts adds .is-on while the hero is on screen — off screen the
     fields hold still; under reduced motion they never move. */
  .hero__aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .aurora {
    position: absolute;
    border-radius: 50%;
    animation: aurora-a 40s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .hero__aurora.is-on .aurora {
    animation-play-state: running;
  }
  /* with the light fields behind it the grid should whisper, not draw lines through the glow */
  .hero :global(.bg-grid) {
    opacity: 0.6;
  }
  /* ---- the field: the grid, awake (field.ts) ----
     A canvas of dots on the top part of the hero (the headline's screen, not the console below): the
     cursor pushes and lights them, a wave runs out from the headline as it lands, a tap sends one.
     Same mask shape as the CSS grid so it dissolves toward the edges; once the script has taken over,
     the line grid is hidden — without JS it stays. */
  .hero__field {
    position: absolute;
    left: 0;
    top: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: min(100%, 115vh);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, #000 30%, transparent 82%);
    mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, #000 30%, transparent 82%);
  }
  .hero.is-field :global(.bg-grid) {
    display: none;
  }
  .aurora--a {
    width: 520px;
    height: 360px;
    left: 50%;
    top: -160px;
    background: radial-gradient(closest-side, rgba(198, 255, 74, 0.18), rgba(198, 255, 74, 0.05) 55%, transparent);
    animation-name: aurora-a;
    animation-duration: 38s;
  }
  .aurora--b {
    width: 480px;
    height: 360px;
    left: calc(50% + 35px);
    top: 380px;
    background: radial-gradient(closest-side, rgba(88, 230, 196, 0.16), rgba(88, 230, 196, 0.05) 55%, transparent);
    animation-name: aurora-b;
    animation-duration: 44s;
    animation-delay: -14s;
  }
  .aurora--c {
    width: 400px;
    height: 280px;
    left: -160px;
    top: -120px;
    background: radial-gradient(closest-side, rgba(198, 255, 74, 0.1), rgba(198, 255, 74, 0.03) 55%, transparent);
    animation-name: aurora-c;
    animation-duration: 34s;
    animation-delay: -22s;
  }
  @keyframes aurora-a {
    to {
      transform: translate(-60px, 40px) scale(1.08);
    }
  }
  @keyframes aurora-b {
    to {
      transform: translate(50px, -50px) scale(1.1);
    }
  }
  @keyframes aurora-c {
    to {
      transform: translate(40px, 30px) scale(1.06);
    }
  }
  @media (min-width: 960px) {
    .aurora--a {
      width: 900px;
      height: 620px;
      left: calc(50% + 120px);
      top: -220px;
    }
    .aurora--b {
      width: 760px;
      height: 560px;
      left: calc(50% + 80px);
      top: 140px;
    }
    .aurora--c {
      width: 620px;
      height: 420px;
      left: -200px;
      top: -200px;
    }
  }

  /* ---- entrance (JS-enhanced: html.js only) ----
     Masked word reveal, gentle: each word rises half its height behind the mask while fading in,
     50ms apart, no blur. With 4–6 words the headline has settled by ~950ms. */
  html.js .hero .w__in {
    opacity: 0;
    transform: translateY(50%);
    transition: transform 700ms var(--ease-out-long), opacity 450ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 50ms);
  }
  html.js .hero.is-ready .w__in {
    opacity: 1;
    transform: none;
  }
  /* The console mock (a .reveal inside the hero) waits for the headline: while hero.ts waits for the
     fonts (≤600ms) its entrance stays parked at the first keyframe, so the page never fills bottom-up. */
  html.js .hero:not(.is-ready) :global(.reveal.is-in) {
    animation-play-state: paused;
  }
  /* Staged entrance as one-shot keyframes with `backwards` fill: once finished, the badge's own
     :active scale and 160ms transitions are untouched. */
  html.js .hero .hero__badge,
  html.js .hero .hero__lead,
  html.js .hero .hero__cta,
  html.js .hero .hero__chip {
    opacity: 0;
  }
  html.js .hero.is-ready .hero__badge,
  html.js .hero.is-ready .hero__lead,
  html.js .hero.is-ready .hero__cta,
  html.js .hero.is-ready .hero__chip {
    opacity: 1;
    animation: hero-in 600ms var(--ease-out-long) backwards;
  }
  /* badge 0 → lead 200 → CTA 300 → chips 400 + 50ms each: the whole choreography lands by ~1.1s */
  html.js .hero.is-ready .hero__lead {
    animation-delay: 200ms;
  }
  html.js .hero.is-ready .hero__cta {
    animation-delay: 300ms;
  }
  html.js .hero.is-ready .hero__chip {
    animation-delay: calc(400ms + var(--i, 0) * 50ms);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__badge:hover {
      border-color: rgba(198, 255, 74, 0.5);
      color: var(--fg);
    }
    .hero__badge:hover .hero__badge-link :global(.icon) {
      transform: translateX(2px);
    }
  }
  @media (max-width: 767px) {
    .br-desktop {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .hero .w__in {
      transform: none;
      transition: opacity 220ms ease;
      transition-delay: 0ms;
    }
    html.js .hero.is-ready .hero__badge,
    html.js .hero.is-ready .hero__lead,
    html.js .hero.is-ready .hero__cta,
    html.js .hero.is-ready .hero__chip {
      animation: hero-fade 220ms ease backwards;
      animation-delay: 0ms;
    }
    .hero__badge:active {
      transform: none;
    }
    .aurora {
      animation: none;
    }
  }
</style>

---
import type { Content, Lang } from '../i18n/types';
import { LANGS, LANG_NAMES, localePath } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  t: Content;
  path: string;
}
const { lang, t, path } = Astro.props;
const home = localePath(lang, '/');
const links = [
  ['services', t.nav.services],
  ['process', t.nav.process],
  ['geo', t.nav.geo],
  ['cases', t.nav.cases],
  ['pricing', t.nav.pricing],
  ['contact', t.nav.contact],
] as const;
---

<header class="nav" id="nav" data-nav>
  <div class="container nav__inner">
    <a href={home} class="nav__logo" aria-label={t.brand}>
      <svg class="nav__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 3.2h5.4L12 14l4.2-10.8h5.4L12 21.8z" /></svg>
      <span class="nav__word">{t.brand}</span>
    </a>

    <nav class="nav__links" aria-label={t.nav.menu}>
      {links.map(([id, label]) => (
        <a href={`${home}#${id}`} data-nav-link={id}>{label}</a>
      ))}
    </nav>

    <div class="nav__right">
      <button class="cmdk" type="button" aria-label={t.command.open} aria-haspopup="dialog" aria-expanded="false" aria-controls="cmd" aria-keyshortcuts="Meta+K Control+K" data-cmd-open>
        <Icon name="search" size={14} />
        <kbd class="kbd cmdk__kbd" data-cmd-key>⌘K</kbd>
      </button>
      <div class="lang" data-lang>
        <button class="lang__btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label={t.nav.language}>
          <Icon name="globe" size={14} />
          <span>{lang.toUpperCase()}</span>
          <Icon name="chevron" size={12} class="lang__chev" />
        </button>
        <div class="lang__menu" role="menu" hidden>
          {LANGS.map((l) => (
            <a role="menuitem" href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} data-lang-link>
              <span>{LANG_NAMES[l]}</span>
              <span class="lang__code">{l.toUpperCase()}</span>
            </a>
          ))}
        </div>
      </div>
      <a href={`${home}#contact`} class="btn btn--white btn--sm nav__cta">{t.nav.cta}</a>
      <button class="nav__burger" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <Icon name="menu" size={18} class="nav__burger-open" />
        <Icon name="close" size={18} class="nav__burger-close" />
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" data-mobile hidden>
    <nav class="mobile__links" aria-label={t.nav.menu}>
      {links.map(([id, label], i) => (
        <a href={`${home}#${id}`} data-i={i}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span>{label}</span>
        </a>
      ))}
    </nav>
    <div class="mobile__foot">
      <a href={`${home}#contact`} class="btn btn--primary btn--lg">{t.nav.cta}</a>
      <div class="mobile__langs">
        {LANGS.map((l) => (
          <a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} data-lang-link>{l.toUpperCase()}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--nav-h);
    background: rgba(8, 9, 10, 0.6);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  /* The blur lives on a pseudo-element: backdrop-filter on the header itself would turn it into the
     containing block of the position:fixed mobile panel (and collapse it to the header's height). */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .nav.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(8, 9, 10, 0.78);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 640;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .nav__mark {
    width: 22px;
    height: 22px;
    fill: var(--lime);
    filter: drop-shadow(0 0 8px rgba(198, 255, 74, 0.4));
  }
  .nav__links {
    display: none;
    gap: 2px;
    margin-left: 12px;
  }
  .nav__links a {
    position: relative;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-2);
    transition: color 160ms ease, background-color 160ms ease;
  }
  .nav__links a.is-active {
    color: var(--fg);
  }
  .nav__right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav__cta {
    display: none;
  }

  /* ⌘K trigger: quiet like the language button on desktop, a square icon button next to the burger on mobile */
  .cmdk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 36px;
    padding: 0 7px 0 10px;
    border-radius: var(--r);
    border: 1px solid transparent;
    color: var(--fg-2);
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease, transform 140ms var(--ease-out);
  }
  .cmdk:active {
    transform: scale(0.98);
  }
  .cmdk[aria-expanded='true'],
  .cmdk:focus-visible {
    color: var(--fg);
    border-color: var(--line-2);
    background: rgba(255, 255, 255, 0.04);
  }
  .cmdk .kbd {
    color: var(--fg-3);
    transition: color 160ms ease, border-color 160ms ease;
  }
  .nav__burger {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.03);
    transition: transform 140ms var(--ease-out), border-color 160ms ease, background-color 160ms ease;
  }
  .nav__burger:active {
    transform: scale(0.98);
  }
  /* icon swap: a quiet crossfade with a touch of scale, no rotation */
  .nav__burger :global(.icon) {
    grid-area: 1 / 1;
    transition: opacity 160ms ease, transform 200ms var(--ease-out);
  }
  .nav__burger :global(.nav__burger-close) {
    opacity: 0;
    transform: scale(0.85);
  }
  .nav__burger[aria-expanded='true'] :global(.nav__burger-open) {
    opacity: 0;
    transform: scale(0.85);
  }
  .nav__burger[aria-expanded='true'] :global(.nav__burger-close) {
    opacity: 1;
    transform: none;
  }

  /* language popover — scales from its trigger (top-right) */
  .lang {
    position: relative;
  }
  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--r);
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 560;
    color: var(--fg-2);
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease, transform 140ms var(--ease-out);
  }
  .lang__btn:active {
    transform: scale(0.98);
  }
  .lang__btn[aria-expanded='true'],
  .lang__btn:focus-visible {
    color: var(--fg);
    border-color: var(--line-2);
    background: rgba(255, 255, 255, 0.04);
  }
  .lang__btn :global(.lang__chev) {
    transition: transform 200ms var(--ease-out);
  }
  .lang__btn[aria-expanded='true'] :global(.lang__chev) {
    transform: rotate(180deg);
  }
  .lang__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 176px;
    padding: 6px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line-2);
    background: var(--surface-2);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transform-origin: top right;
    /* opens in 160ms from its trigger (scale 0.98 → 1), closes a little faster: the response snaps */
    transition: opacity 120ms ease, transform 120ms var(--ease-out), visibility 0s linear 120ms;
    opacity: 0;
    transform: scale(0.98);
    visibility: hidden;
  }
  .lang__menu.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out), visibility 0s;
  }
  .lang__menu a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    font-size: 14px;
    color: var(--fg-2);
    transition: background-color 120ms ease, color 120ms ease;
  }
  .lang__menu a[aria-current='page'] {
    color: var(--fg);
  }
  .lang__code {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--fg-3);
  }

  /* mobile menu: full-screen panel */
  .mobile {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 49;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    padding: 20px var(--gutter) max(24px, env(safe-area-inset-bottom));
    opacity: 0;
    transform: translateY(-4px);
    visibility: hidden;
    transition: opacity 150ms ease, transform 150ms var(--ease-out), visibility 0s linear 150ms;
    overflow: auto;
  }
  .mobile.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s;
  }
  .mobile__links {
    display: grid;
  }
  .mobile__links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 26px;
    font-weight: 520;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 150ms ease, transform 150ms var(--ease-out);
  }
  .mobile.is-open .mobile__links a {
    opacity: 1;
    transform: none;
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    transition-delay: calc(30ms + var(--i, 0) * 30ms);
  }
  .mobile__foot {
    margin-top: auto;
    display: grid;
    gap: 20px;
    padding-top: 24px;
  }
  .mobile__foot .btn {
    width: 100%;
  }
  .mobile__langs {
    display: flex;
    gap: 6px;
  }
  .mobile__langs a {
    flex: 1;
    text-align: center;
    padding: 10px 0;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--fg-2);
  }
  .mobile__langs a[aria-current='page'] {
    color: var(--fg);
    border-color: rgba(255, 255, 255, 0.4);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--fg);
      background: rgba(255, 255, 255, 0.04);
    }
    .lang__btn:hover {
      color: var(--fg);
    }
    .cmdk:hover {
      color: var(--fg);
      border-color: var(--line-2);
      background: rgba(255, 255, 255, 0.04);
    }
    .cmdk:hover .kbd {
      color: var(--fg);
      border-color: rgba(255, 255, 255, 0.25);
    }
    .lang__menu a:hover {
      background: rgba(255, 255, 255, 0.05);
      color: var(--fg);
    }
  }
  @media (max-width: 1023px) {
    .cmdk {
      width: 36px;
      padding: 0;
      border-color: var(--line-2);
      background: rgba(255, 255, 255, 0.03);
    }
    .cmdk .kbd {
      display: none;
    }
    .nav__right .lang {
      order: -1; /* RU ▾ · ⌘K · ☰ — the search button sits next to the burger */
    }
  }
  @media (min-width: 1024px) {
    .nav__links {
      display: flex;
    }
    .nav__cta {
      display: inline-flex;
    }
    .nav__burger,
    .mobile {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lang__menu,
    .mobile,
    .mobile__links a,
    .nav__burger :global(.icon),
    .nav__burger:active,
    .lang__btn:active,
    .cmdk:active {
      transform: none;
    }
    .mobile.is-open .mobile__links a {
      transition-delay: 0s;
    }
  }
</style>

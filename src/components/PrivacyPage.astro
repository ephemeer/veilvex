---
import type { Content, Lang } from '../i18n/types';
import { localePath } from '../i18n';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
const p = t.privacy;
---
<section class="privacy">
  <div class="container privacy__inner">
    <a href={localePath(lang, '/')} class="link-arrow privacy__back"><Icon name="arrow" class="privacy__back-icon" />{p.back}</a>
    <span class="eyebrow">{t.footer.legal}</span>
    <h1 class="h2 privacy__title">{p.title}</h1>
    <p class="mono privacy__date">{p.updated}</p>
    <p class="lead">{p.intro}</p>
    <div class="privacy__body">
      {p.sections.map((s, i) => (
        <section class="privacy__section">
          <h2 class="h3"><span class="num"><b>{String(i + 1).padStart(2, '0')}</b></span> {s.h}</h2>
          {s.p.map((para) => <p>{para}</p>)}
        </section>
      ))}
    </div>
  </div>
</section>
<style>
  .privacy {
    padding: calc(var(--nav-h) + 64px) 0 96px;
  }
  .privacy__inner {
    max-width: 780px;
    display: grid;
    gap: 16px;
  }
  .privacy__back {
    margin-bottom: 24px;
  }
  .privacy__back :global(.privacy__back-icon) {
    transform: rotate(180deg);
  }
  .privacy__date {
    margin-top: -4px;
  }
  .privacy__body {
    display: grid;
    gap: 36px;
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .privacy__section {
    display: grid;
    gap: 12px;
  }
  .privacy__section h2 {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .privacy__section p {
    color: var(--fg-2);
    line-height: 1.65;
  }
</style>

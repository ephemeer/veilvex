---
import { rich } from '../i18n';
interface Props {
  tag: string;
  title: string;
  lead?: string;
  index?: string; // e.g. "02"
  class?: string;
}
const { tag, title, lead, index, class: cls = '' } = Astro.props;
---
<div class={`section-head ${cls}`.trim()}>
  <span class="eyebrow reveal" data-i="0">{index && <b class="eyebrow__idx">{index}</b>}{tag}</span>
  <h2 class="h2 reveal" data-i="1" set:html={rich(title)} />
  {lead && <p class="lead reveal" data-i="2" set:html={rich(lead)} />}
</div>
<style>
  .eyebrow__idx {
    font-weight: 500;
    color: var(--fg-3);
    margin-right: 2px;
  }
</style>

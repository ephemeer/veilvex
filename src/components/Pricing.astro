---
import type { Content, Lang } from '../i18n/types';
import { localePath, pad2 } from '../i18n';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
const home = localePath(lang, '/');
const serviceOf = ['site', 'ads', 'app', 'smm', 'design', 'geo'];
---
<section class="section pricing" id="pricing">
  <div class="container">
    <SectionHead index="08" tag={t.pricing.tag} title={t.pricing.title} lead={t.pricing.note} />
    <ul class="pricing__grid">
      {t.pricing.tiers.map((p, i) => (
        <li class={`card tier reveal${p.popular ? ' is-popular' : ''}`} data-i={i} data-spotlight>
          <div class="tier__top">
            <span class={`chip${p.popular ? ' chip--lime' : ''}`}>{p.popular && <Icon name="bolt" size={11} />}{p.badge}</span>
            <span class="num"><b>{pad2(i + 1)}</b></span>
          </div>
          <h3 class="h3 tier__title">{p.title}</h3>
          <p class="tier__value">{p.value}</p>
          <p class="tier__note">{t.pricing.valueNote}</p>
          <ul class="tier__list">
            {p.features.map((f) => (
              <li><Icon name="check" size={12} />{f}</li>
            ))}
          </ul>
          <a href={`${home}#contact`} class={`btn ${p.popular ? 'btn--primary' : 'btn--secondary'} tier__cta`} data-service={serviceOf[i]}>{p.cta}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .pricing__grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  .tier {
    display: grid;
    gap: 14px;
    padding: 24px;
  }
  .tier.is-popular {
    border-color: rgba(198, 255, 74, 0.5);
    background: linear-gradient(180deg, rgba(198, 255, 74, 0.06), rgba(255, 255, 255, 0.01));
  }
  .tier__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tier__title {
    margin-top: 6px;
  }
  .tier__top .chip {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
  }
  .tier__value {
    font-size: 22px;
    font-weight: 540;
    letter-spacing: -0.02em;
  }
  .tier__note {
    margin-top: -8px;
    font-size: 12.5px;
    color: var(--fg-3);
  }
  .tier__list {
    display: grid;
    gap: 9px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .tier__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }
  .tier__list :global(.icon) {
    color: var(--lime);
  }
  .tier__cta {
    margin-top: 10px;
    width: 100%;
  }
  @media (min-width: 640px) {
    .pricing__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .pricing__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

---
/**
 * ⌘K / Ctrl+K command bar. Everything is server-rendered (items, groups, hints) so the strict CSP
 * needs no data blocks; src/scripts/command-bar.ts only filters, moves the selection and acts.
 * Combobox (the input) + listbox (the options): focus stays in the input, the highlighted option is
 * exposed through aria-activedescendant / aria-selected.
 */
import type { Content, Lang } from '../i18n/types';
import { LANGS, LANG_NAMES, localePath } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  t: Content;
  /** Page path without the language prefix, e.g. '/' or '/privacy' */
  path: string;
}
const { lang, t, path } = Astro.props;
const c = t.command;
const k = c.keywords;
const home = localePath(lang, '/');

const sections = [
  { id: 'services', label: t.nav.services, icon: 'spark', keywords: k.services },
  { id: 'process', label: t.nav.process, icon: 'bolt', keywords: k.process },
  { id: 'geo', label: t.nav.geo, icon: 'chat', keywords: k.geo },
  { id: 'cases', label: t.nav.cases, icon: 'arrow-up-right', keywords: k.cases },
  { id: 'pricing', label: t.nav.pricing, icon: 'check', keywords: k.pricing },
  { id: 'faq', label: t.faq.tag, icon: 'plus', keywords: k.faq },
  { id: 'contact', label: t.nav.contact, icon: 'mail', keywords: k.contact },
];
let n = 0;
const optionId = () => `cmd-opt-${n++}`;
---

<div class="cmd" id="cmd" data-cmd hidden>
  <div class="cmd__backdrop" data-cmd-backdrop></div>
  <div class="cmd__dialog" role="dialog" aria-modal="true" aria-labelledby="cmd-title" data-cmd-dialog>
    <h2 class="sr-only" id="cmd-title">{c.title}</h2>

    <div class="cmd__head">
      <Icon name="search" size={16} class="cmd__search" />
      <label class="sr-only" for="cmd-input">{c.title}</label>
      <input
        class="cmd__input"
        id="cmd-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmd-list"
        aria-autocomplete="list"
        aria-activedescendant=""
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder={c.placeholder}
        data-cmd-input
      />
      <button class="cmd__close" type="button" aria-label={t.nav.close} data-cmd-close>
        <kbd class="kbd cmd__esc" aria-hidden="true">esc</kbd>
        <Icon name="close" size={14} class="cmd__x" />
      </button>
    </div>

    <div class="cmd__body" data-cmd-body>
      <div class="cmd__list" id="cmd-list" role="listbox" aria-label={c.title} data-cmd-list>
        <div class="cmd__group" role="group" aria-labelledby="cmd-g-sections" data-cmd-group>
          <div class="cmd__group-h" id="cmd-g-sections">{c.sections}</div>
          {sections.map((s) => (
            <div class="cmd__item" role="option" id={optionId()} aria-selected="false" data-cmd-item data-cmd-section={s.id} data-href={`${home}#${s.id}`} data-keywords={s.keywords}>
              <span class="cmd__icon"><Icon name={s.icon} size={15} /></span>
              <span class="cmd__label">{s.label}</span>
              <span class="cmd__hint">#{s.id}</span>
            </div>
          ))}
          <div class="cmd__item" role="option" id={optionId()} aria-selected="false" data-cmd-item data-href={localePath(lang, '/privacy')} data-keywords={k.privacy}>
            <span class="cmd__icon"><Icon name="shield" size={15} /></span>
            <span class="cmd__label">{t.footer.privacy}</span>
            <span class="cmd__hint">/privacy</span>
          </div>
          <div class="cmd__item" role="option" id={optionId()} aria-selected="false" data-cmd-item data-href={localePath(lang, '/terms')} data-keywords={k.terms}>
            <span class="cmd__icon"><Icon name="contract" size={15} /></span>
            <span class="cmd__label">{t.footer.terms}</span>
            <span class="cmd__hint">/terms</span>
          </div>
        </div>

        <div class="cmd__group" role="group" aria-labelledby="cmd-g-lang" data-cmd-group>
          <div class="cmd__group-h" id="cmd-g-lang">{t.nav.language}</div>
          {LANGS.map((l) => (
            <div class="cmd__item" role="option" id={optionId()} aria-selected="false" aria-current={l === lang ? 'true' : undefined} data-cmd-item data-cmd-lang={l} data-href={localePath(l, path)} data-keywords={k[l]}>
              <span class="cmd__icon"><Icon name="globe" size={15} /></span>
              <span class="cmd__label" lang={l}>{LANG_NAMES[l]}</span>
              {l === lang ? (
                <span class="cmd__hint cmd__hint--current"><Icon name="check" size={12} />{c.current}</span>
              ) : (
                <span class="cmd__hint">{l.toUpperCase()}</span>
              )}
            </div>
          ))}
        </div>

        <div class="cmd__group" role="group" aria-labelledby="cmd-g-actions" data-cmd-group>
          <div class="cmd__group-h" id="cmd-g-actions">{c.actions}</div>
          <div class="cmd__item" role="option" id={optionId()} aria-selected="false" data-cmd-item data-cmd-action="request" data-href={`${home}#contact`} data-keywords={k.request}>
            <span class="cmd__icon cmd__icon--lime"><Icon name="send" size={15} /></span>
            <span class="cmd__label">{c.request}</span>
            <span class="cmd__hint"><Icon name="arrow" size={12} /></span>
          </div>
        </div>
      </div>
      <p class="cmd__empty" data-cmd-empty hidden>{c.empty}</p>
    </div>

    <div class="cmd__foot" aria-hidden="true">
      <span class="cmd__key"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd>{c.hintNav}</span>
      <span class="cmd__key"><kbd class="kbd">↵</kbd>{c.hintOpen}</span>
      <span class="cmd__key"><kbd class="kbd">esc</kbd>{c.hintClose}</span>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-cmd-status></p>
  </div>
</div>

<style>
  /* Scroll lock while open; the vanished scrollbar's width is compensated with inline padding on <html>
     and the header by the shared lock in util.ts (inline, not a custom property: a custom-property
     write on <html> restyles the whole page). */
  :global(html.is-cmd-open) {
    overflow: hidden;
  }

  .cmd {
    --cmd-top: 15vh;
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--cmd-top) 12px 12px;
  }
  .cmd__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 9, 10, 0.6);
    opacity: 0;
    transition: opacity 150ms var(--ease-out);
  }
  .cmd__dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 560px;
    max-height: calc(100vh - var(--cmd-top) - 16px);
    max-height: calc(100dvh - var(--cmd-top) - 16px);
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.6), 0 8px 24px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    /* modal: stays centered, 0.98 → 1 (never from 0) */
    transform-origin: center;
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out);
  }
  .cmd.is-open .cmd__backdrop {
    opacity: 1;
  }
  .cmd.is-open .cmd__dialog {
    opacity: 1;
    transform: none;
  }
  .cmd.is-closing .cmd__backdrop,
  .cmd.is-closing .cmd__dialog {
    transition-duration: 120ms;
  }

  /* head: search field */
  .cmd__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    height: 54px;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid var(--line);
  }
  .cmd__head :global(.cmd__search) {
    color: var(--fg-3);
    transition: color 160ms ease;
  }
  .cmd__head:focus-within :global(.cmd__search) {
    color: var(--lime);
  }
  .cmd__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font-size: 15px;
    caret-color: var(--lime);
  }
  .cmd__input::placeholder {
    color: var(--fg-3);
  }
  .cmd__input:focus,
  .cmd__input:focus-visible {
    /* the lime search icon + caret are the focus indicator; a ring around a full-width field is noise */
    outline: none;
  }
  .cmd__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    color: var(--fg-3);
    transition: color 160ms ease, transform 140ms var(--ease-out);
  }
  .cmd__close:active {
    transform: scale(0.98);
  }
  .cmd__close :global(.cmd__x) {
    display: none;
  }

  /* body: scrollable list */
  .cmd__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
  }
  .cmd__group {
    padding: 2px 0 4px;
  }
  .cmd__group + .cmd__group {
    margin-top: 2px;
    border-top: 1px solid var(--line);
    padding-top: 6px;
  }
  .cmd__group-h {
    padding: 8px 10px 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .cmd__item {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 10px;
    border-radius: var(--r);
    color: var(--fg-2);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    /* seen on every keystroke — the highlight snaps, it does not animate */
  }
  .cmd__item[aria-selected='true'] {
    background: rgba(255, 255, 255, 0.06);
    color: var(--fg);
  }
  .cmd__icon {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--fg-3);
  }
  .cmd__item[aria-selected='true'] .cmd__icon {
    color: var(--fg);
  }
  .cmd__item .cmd__icon--lime {
    color: var(--lime);
  }
  .cmd__label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cmd__hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    white-space: nowrap;
  }
  .cmd__hint--current {
    color: var(--lime);
  }
  .cmd__empty {
    padding: 28px 16px 32px;
    text-align: center;
    font-size: 14px;
    color: var(--fg-3);
  }

  /* foot: key hints */
  .cmd__foot {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: none;
    height: 40px;
    padding: 0 14px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--fg-3);
  }
  .cmd__key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cmd__key .kbd + .kbd {
    margin-left: -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cmd__close:hover {
      color: var(--fg);
    }
    .cmd__close:hover .kbd {
      color: var(--fg);
      border-color: rgba(255, 255, 255, 0.25);
    }
  }
  @media (max-width: 767px) {
    .cmd {
      --cmd-top: 8vh;
    }
    .cmd__head {
      height: 52px;
      padding-left: 14px;
    }
    .cmd__input {
      font-size: 16px; /* prevents the iOS zoom-on-focus */
    }
    .cmd__close {
      width: 28px;
      border: 1px solid var(--line-2);
      background: rgba(255, 255, 255, 0.03);
    }
    .cmd__close .kbd {
      display: none;
    }
    .cmd__close :global(.cmd__x) {
      display: block;
    }
    .cmd__foot {
      display: none; /* keyboard hints mean nothing on touch */
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmd__dialog {
      transform: none;
      transition: opacity 150ms var(--ease-out);
    }
    .cmd__close:active {
      transform: none;
    }
  }
</style>

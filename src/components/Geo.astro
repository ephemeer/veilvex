---
import type { Content, Lang } from '../i18n/types';
import { hl, localePath, plain } from '../i18n';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
const home = localePath(lang, '/');
const g = t.geo;
// Visibility shown when a model chip is pressed (geo.ts) — deterministic, same order as g.models.
const VISIBILITY = [92, 88, 90, 86, 81, 77];
const OVERALL = 92;
// Orbit behind the chat card: two rings (600×600 viewBox, centre 300) with six dots at uneven angles
// and sizes — a constellation, not a spinner — plus a few static stars. Rotation is CSS (transform).
const C = 300;
const RING_A = 250;
const RING_B = 178;
const pt = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(C + r * Math.cos(a)).toFixed(1), y: +(C + r * Math.sin(a)).toFixed(1) };
};
const DOTS_A = [
  [20, 3.2, 'lime'],
  [110, 2.4, 'mint'],
  [205, 3.6, 'lime'],
  [300, 2.6, 'mint'],
] as const;
const DOTS_B = [
  [60, 2.8, 'mint'],
  [250, 2.2, 'lime'],
] as const;
const STARS = [
  [88, 96],
  [472, 150],
  [540, 392],
  [150, 486],
  [396, 540],
  [250, 70],
] as const;
---
<section class="section geo" id="geo">
  <div class="container geo__grid">
    <div class="geo__text">
      <SectionHead index="04" tag={g.tag} title={g.title} lead={g.lead} />
      <ol class="geo__steps">
        {g.steps.map((s, i) => (
          <li class="geo__step reveal" data-i={i}>
            <span class="num"><b>0{i + 1}</b></span>
            <div>
              <h3 class="geo__step-t">{s.title}</h3>
              <p class="geo__step-d">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <ul class="geo__models reveal" aria-label="AI">
        {g.models.map((m, i) => (
          <li>
            <button type="button" class="chip geo__model" data-i={i} data-model data-pct={VISIBILITY[i] ?? OVERALL} aria-pressed="false">{m}</button>
          </li>
        ))}
      </ul>
      <a href={`${home}#contact`} class="link-arrow geo__more reveal" data-service="geo">{g.more}<Icon name="arrow" /></a>
    </div>

    <div class="geo__visual reveal" data-ambient-box>
      <div class="orbit" aria-hidden="true" data-ambient data-orbit>
        <svg class="orbit__svg" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
          {STARS.map(([x, y]) => (
            <circle class="orbit__star" cx={x} cy={y} r="1.4" />
          ))}
          <g class="orbit__ring orbit__ring--a" data-orbit-ring>
            <circle class="orbit__path" cx={C} cy={C} r={RING_A} vector-effect="non-scaling-stroke" />
            {DOTS_A.map(([deg, r, hue]) => {
              const p = pt(RING_A, deg);
              return <circle class={`orbit__dot orbit__dot--${hue}`} cx={p.x} cy={p.y} r={r} />;
            })}
          </g>
          <g class="orbit__ring orbit__ring--b" data-orbit-ring>
            <circle class="orbit__path orbit__path--dash" cx={C} cy={C} r={RING_B} vector-effect="non-scaling-stroke" />
            {DOTS_B.map(([deg, r, hue]) => {
              const p = pt(RING_B, deg);
              return <circle class={`orbit__dot orbit__dot--${hue}`} cx={p.x} cy={p.y} r={r} />;
            })}
          </g>
        </svg>
      </div>
      <div class="chat" data-chat data-answer={g.chat.answer}>
        <div class="chat__head">
          <span class="chat__avatar"><Icon name="spark" size={14} /></span>
          <div class="chat__who">
            <b>{g.chat.name}</b>
            <span class="chat__status"><i class="dot" aria-hidden="true"></i>{g.chat.status}</span>
          </div>
          <span class="chip">{g.chat.sample}</span>
        </div>
        <div class="chat__body">
          <div class="chat__msg chat__msg--user" data-chat-q>{g.chat.question}</div>
          <div class="chat__typing" data-chat-typing role="status" aria-label={g.chat.typing}><i></i><i></i><i></i></div>
          <div class="chat__msg chat__msg--ai" data-chat-a>
            <span class="chat__text" data-chat-text set:html={hl(g.chat.answer)} />
          </div>
        </div>
        <div class="chat__meter">
          <span class="chat__meter-l" data-chat-label>{g.chat.meter}</span>
          <span class="chat__meter-bar" aria-hidden="true"><i data-chat-meter></i></span>
          <span class="chat__meter-v mono" data-chat-pct aria-label={plain(g.chat.meter)}>92%</span>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .geo__grid {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  .geo__steps {
    display: grid;
    gap: 18px;
    margin-top: -16px;
  }
  .geo__step {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .geo__step-t {
    font-size: 16px;
    font-weight: 560;
    letter-spacing: -0.01em;
  }
  .geo__step-d {
    margin-top: 4px;
    font-size: 14px;
    color: var(--fg-2);
  }
  .geo__models {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .geo__model {
    /* a real button: the lit state changes colour only, the press is the house 140ms / 0.98 */
    transition: color 220ms ease, border-color 220ms ease, background-color 220ms ease, transform 140ms var(--ease-out);
  }
  .geo__model:active {
    transform: scale(0.98);
  }
  .geo__model.is-lit {
    color: var(--lime);
    border-color: rgba(198, 255, 74, 0.45);
    background: var(--lime-dim);
  }
  .geo__more {
    margin-top: 28px;
  }

  /* orbit: a quiet constellation behind the chat card — two thin rings (lime 20%, mint 18%, 1px) with
     six dots of different sizes turning once a minute (the inner ring the other way, 90s). Rotation is
     a transform on the group; ambient.ts runs it only while the card is on screen; reduced motion keeps
     it still. The box is clipped so nothing reaches the text column (desktop: 8% over the left edge of
     the card, 26% to the right). The whole thing sits at 60% opacity behind the card. */
  .geo {
    /* the orbit may run past the viewport edge; clip (not hidden) keeps the sticky visual working and
       adds no horizontal scroll */
    overflow-x: clip;
  }
  .geo__visual {
    position: relative;
    z-index: 0;
  }
  .orbit {
    /* phones: the card is taller than wide, so the rings are centred 150px below its top edge and
       sized to 130% of its width — the outer ring rises as an arc into the gap above the card (44px)
       and peeks out at the sides; the box ends at the gutters, so it never adds horizontal scroll */
    position: absolute;
    z-index: -1;
    left: calc(var(--gutter) * -1);
    right: calc(var(--gutter) * -1);
    top: -44px;
    bottom: 0;
    overflow: hidden;
    opacity: 0.6;
    pointer-events: none;
  }
  .orbit__svg {
    position: absolute;
    top: 194px;
    left: 50%;
    width: 130%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    overflow: visible;
  }
  .orbit__path {
    fill: none;
    stroke: rgba(198, 255, 74, 0.2);
    stroke-width: 1;
  }
  .orbit__path--dash {
    stroke: rgba(88, 230, 196, 0.18);
    stroke-dasharray: 2 7;
  }
  .orbit__dot--lime {
    fill: var(--lime);
  }
  .orbit__dot--mint {
    fill: var(--mint);
  }
  .orbit__star {
    fill: rgba(198, 255, 74, 0.35);
  }
  .orbit__ring {
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: orbit-turn 60s linear infinite;
    animation-play-state: paused;
  }
  .orbit__ring--b {
    animation-duration: 90s;
    animation-direction: reverse;
  }
  .orbit.is-on .orbit__ring {
    animation-play-state: running;
  }
  @keyframes orbit-turn {
    to {
      transform: rotate(1turn);
    }
  }

  /* chat mock */
  .chat {
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: linear-gradient(180deg, #101114, #0b0c0e);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .chat__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--lime-ink);
  }
  .chat__who {
    display: grid;
    font-size: 14px;
  }
  .chat__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--fg-2);
  }
  .chat__head .chip {
    margin-left: auto;
  }
  .chat__body {
    display: grid;
    gap: 12px;
    padding: 20px 16px;
    min-height: 240px;
    align-content: start;
  }
  .chat__msg {
    max-width: 88%;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .chat__msg--user {
    justify-self: end;
    background: var(--surface-3);
    border-bottom-right-radius: 4px;
  }
  .chat__msg--ai {
    justify-self: start;
    border: 1px solid rgba(198, 255, 74, 0.25);
    background: rgba(198, 255, 74, 0.05);
    border-bottom-left-radius: 4px;
  }
  .chat__typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    background: var(--surface-2);
    justify-self: start;
  }
  .chat__typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-2);
  }
  /* the dots only breathe while the bubble is on screen — nothing loops in the background */
  .chat__typing.is-shown i {
    animation: typing 1.2s ease-in-out infinite;
  }
  .chat__typing.is-shown i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .chat__typing.is-shown i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes typing {
    50% {
      opacity: 0.35;
    }
  }
  .chat__caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--lime);
    animation: caret 0.8s steps(2) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .chat__meter {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 12px;
    padding: 14px 16px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--fg-2);
  }
  .chat__meter-bar {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }
  .chat__meter-bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--lime-2), var(--lime));
    transform-origin: left;
    transform: scaleX(0.92);
  }
  .chat__meter-v {
    color: var(--lime);
    font-variant-numeric: tabular-nums;
  }

  /* JS choreography: start hidden only when JS is present. Without JS the typing bubble makes no
     sense next to the finished answer, so it is simply not shown. */
  html:not(.js) .chat__typing {
    display: none;
  }
  html.js .chat__msg--user,
  html.js .chat__msg--ai {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  /* typing bubble and answer share one grid cell: the answer appears exactly where the dots were */
  html.js .chat__typing,
  html.js .chat__msg--ai {
    grid-area: 2 / 1;
    align-self: start; /* grid items stretch by default; the bubble must keep its own height */
  }
  html.js .chat__typing {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  html.js .chat .is-shown {
    opacity: 1;
    transform: none;
  }
  html.js .chat__meter-bar i {
    transform: scaleX(0);
    transition: transform 900ms var(--ease-out);
  }
  html.js .chat.is-done .chat__meter-bar i {
    transform: scaleX(0.92);
  }

  @media (hover: hover) and (pointer: fine) {
    .geo__model:hover {
      color: var(--fg);
      border-color: rgba(255, 255, 255, 0.25);
    }
    .geo__model.is-lit:hover {
      color: var(--lime);
      border-color: rgba(198, 255, 74, 0.65);
    }
  }
  @media (min-width: 960px) {
    .geo__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }
    .geo__visual {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
    .orbit {
      left: -8%;
      right: -26%;
      top: -16%;
      bottom: -16%;
    }
    .orbit__svg {
      top: 50%;
      left: 0;
      width: 100%;
      transform: translateY(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .chat__msg--user,
    html.js .chat__msg--ai {
      transform: none;
      transition: opacity 200ms ease;
    }
    .chat__typing.is-shown i,
    .chat__caret {
      animation: none;
    }
    html.js .chat__meter-bar i {
      transition: none;
    }
    .geo__model:active {
      transform: none;
    }
    .orbit__ring {
      animation: none;
    }
  }
</style>

---
import type { Content } from '../i18n/types';
import SectionHead from './SectionHead.astro';
interface Props {
  t: Content;
}
const { t } = Astro.props;
---
<section class="section trust" id="trust">
  <div class="container">
    <SectionHead index="05" tag={t.trust.tag} title={t.trust.title} lead={t.trust.lead} />
    <ul class="trust__grid">
      {t.trust.items.map((it, i) => (
        <li class="trust__item reveal" data-i={i}>
          <span class="num"><b>0{i + 1}</b></span>
          <h3 class="trust__title">{it.title}</h3>
          <p class="trust__desc">{it.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .trust__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  .trust__item {
    display: grid;
    gap: 10px;
    padding: 28px 24px;
    background: var(--bg);
    transition: background-color 200ms ease;
  }
  .trust__title {
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.01em;
    margin-top: 6px;
  }
  .trust__desc {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.55;
  }
  @media (hover: hover) and (pointer: fine) {
    .trust__item:hover {
      background: var(--bg-2);
    }
  }
  @media (min-width: 640px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .trust__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

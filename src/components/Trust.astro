---
import type { Content } from '../i18n/types';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
interface Props {
  t: Content;
}
const { t } = Astro.props;
// one line icon per guarantee, in content order: contract, staged payments, reports, source files, support, one team
const ICONS = ['contract', 'stages', 'report', 'files', 'support', 'team'];
---
<section class="section trust" id="trust">
  <div class="container">
    <SectionHead index="05" tag={t.trust.tag} title={t.trust.title} lead={t.trust.lead} />
    <ul class="trust__grid">
      {t.trust.items.map((it, i) => (
        <li class="trust__item reveal" data-i={i}>
          <div class="trust__top">
            <span class="trust__icon" data-draw data-draw-delay="150"><Icon name={ICONS[i] ?? 'shield'} size={22} /></span>
            <span class="num"><b>0{i + 1}</b></span>
          </div>
          <h3 class="trust__title">{it.title}</h3>
          <p class="trust__desc">{it.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .trust__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  .trust__item {
    display: grid;
    gap: 10px;
    padding: 28px 24px;
    background: var(--bg);
    transition: background-color 200ms ease;
  }
  /* Focus on one guarantee: the tile under the pointer (or holding keyboard focus) stays at 100%,
     the other five dim to 65% — 200ms, no delay, symmetric (a system response), so a sweep across the
     row is one calm crossfade and nothing flickers. The content dims, not the tile: the tiles are
     opaque panes on the hairline grid, and a translucent pane would let the grid colour through. */
  .trust__item > * {
    transition: opacity 200ms ease;
  }
  .trust__grid:focus-within .trust__item:not(:focus-within):not(:hover) > * {
    opacity: 0.65;
  }
  .trust__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* 22px line icon, lime at 85%; draw.ts draws its stroke once as the tile reveals */
  .trust__icon {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: rgba(198, 255, 74, 0.85);
  }
  .trust__title {
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.01em;
    margin-top: 6px;
  }
  .trust__desc {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.55;
  }
  @media (hover: hover) and (pointer: fine) {
    .trust__item:hover {
      background: var(--bg-2);
    }
    .trust__grid:hover .trust__item:not(:hover):not(:focus-within) > * {
      opacity: 0.65;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust__item > * {
      transition: none;
    }
  }
  @media (min-width: 640px) {
    .trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .trust__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# On Netlify set these in Site configuration → Environment variables.

# Public site URL (used for same-origin checks of the contact form)
SITE_URL=https://veilvex.example

# Delivery channel 1: Telegram bot (create via @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery channel 2: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: rate limit tuning (requests per IP per window, window in seconds)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=600
# Optional: site-wide ceiling for all IPs together over the same window
CONTACT_GLOBAL_RATE_LIMIT=60
